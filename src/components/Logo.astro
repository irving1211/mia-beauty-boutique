---
export interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'dark' | 'light';
}
const { size = 'md', variant = 'dark' } = Astro.props;
// Logo asset is a horizontal lockup: MB-monogram-with-crown + Mía + BEAUTY BOUTIQUE.
// Source: public/images/brand/logo-mb-mia-{dark|light}.png
// Heights tuned for header (md ~ 72px tall) and footer (sm ~ 44px tall).
const BASE = import.meta.env.BASE_URL;
const file = variant === 'light' ? 'logo-mb-mia-light.png' : 'logo-mb-mia-dark.png';
const src = `${BASE}images/brand/${file}`;
---

<img
  src={src}
  alt="Mía Beauty Boutique"
  class={`mia-logo mia-logo-${size}`}
  loading="eager"
  decoding="async"
/>

<style>
  .mia-logo { display: block; width: auto; max-width: 100%; }
  .mia-logo-sm { height: 44px; }
  .mia-logo-md { height: 72px; }
  .mia-logo-lg { height: 100px; }

  @media (max-width: 900px) {
    .mia-logo-md { height: 56px; }
  }
</style>
