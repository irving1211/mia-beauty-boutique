---
export interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'dark' | 'light';
}
const { size = 'md', variant = 'dark' } = Astro.props;
// Approved brand logo system (extracted from "color salon logo 1.png"):
//   dark  -> logo-primary-color.png   (gold MB monogram + crown + dark wordmark, for light bg)
//   light -> logo-primary-reverse.png (gold monogram + cream wordmark, for dark bg)
// Stacked lockup ~1.35:1. Heights tuned for header (md) and footer (sm).
const BASE = import.meta.env.BASE_URL;
const file = variant === 'light' ? 'logo-primary-reverse.png' : 'logo-primary-color.png';
const src = `${BASE}images/brand/${file}`;
---

<img
  src={src}
  alt="Mía Beauty Boutique"
  class={`mia-logo mia-logo-${size}`}
  loading="eager"
  decoding="async"
/>

<style>
  .mia-logo { display: block; width: auto; max-width: 100%; }
  .mia-logo-sm { height: 56px; }
  .mia-logo-md { height: 78px; }
  .mia-logo-lg { height: 110px; }

  @media (max-width: 900px) {
    .mia-logo-md { height: 62px; }
  }
</style>
