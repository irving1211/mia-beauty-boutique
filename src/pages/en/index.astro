---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';

const phone = '(978) 208-7877';
const phoneTel = '+19782087877';
const address = '264 S Broadway, Lawrence, MA 01843';
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=264+S+Broadway%2C+Lawrence%2C+MA+01843';
const mapsUrl = 'https://www.google.com/maps/place/264+S+Broadway,+Lawrence,+MA+01843';
const reviewsUrl = 'https://www.google.com/search?q=Mia+Beauty+Boutique+Lawrence+MA';
const writeReviewUrl = 'https://search.google.com/local/writereview?placeid=ChIJ_____MiaBeautyBoutique';
const instagramUrl = 'https://www.instagram.com/miabeautyboutique264/';
const facebookUrl = 'https://www.facebook.com/p/Mia-Beauty-Boutique-100058155380527/';
const yelpUrl = 'https://www.yelp.com/biz/mia-beauty-boutique-lawrence-2';

const BASE = import.meta.env.BASE_URL;
const img = (name: string) => `${BASE}images/work/${name}`;

const services = [
  { title: 'Dominican Blowout', icon: '✦', body: 'Our specialty. Soft, shiny, full-bodied hair — the Dominican blowout that made us famous.', price: 'From $45' },
  { title: 'Color & Highlights', icon: '✦', body: 'Color, balayage, plum, ombré. Pravana and top brands. Healthy hair always first.', price: 'Call for consult' },
  { title: 'Haircuts', icon: '✦', body: 'Classic, modern, layered, bangs. Cuts that make you look and feel your best.', price: 'From $30' },
  { title: 'Extensions', icon: '✦', body: 'Brazilian and natural-hair extensions. Volume, length, full transformation.', price: 'Consult required' },
  { title: 'Professional Makeup', icon: '✦', body: 'For events, photoshoots, or just to feel extra beautiful. Luxury brands.', price: 'From $65' },
  { title: 'Bridal', icon: '✦', body: 'Bridal makeup and styling. Special service — book your date ahead of time.', price: 'By appointment' },
  { title: 'Threading', icon: '✦', body: 'Eyebrows, upper lip, full face. Precise, gentle technique for sensitive skin.', price: 'From $12' },
  { title: 'Hair Treatments', icon: '✦', body: 'Deep conditioning, keratin, shine, and repair for every hair type.', price: 'From $40' },
];

const whyMia = [
  { title: 'Authentic Dominican craft', body: '40+ years specializing in Dominican hair. We know curls, waves, textures — and how to bring out their best.' },
  { title: 'Walk-ins, no stress', body: "Walk-ins welcome. Come when you can, we'll get you in. Perfect for busy moms and tight schedules." },
  { title: 'Bilingual & family-run', body: "We greet you in English or Spanish. Family salon — three generations of clients, zero factory feel." },
  { title: 'Results that last', body: 'Blowouts that last the week. Color that protects your hair. Decades of craft behind every chair.' },
];

const stylists = [
  { name: 'Mía', role: 'Founder · Master Stylist', body: '40+ years perfecting the Dominican blowout. Three generations of clients know her by name.' },
  { name: 'The team', role: 'Bilingual Stylists', body: 'Specialists in color, cuts, extensions, bridal, and makeup. We work as a team — someone is always ready for you.' },
];

const reviews = [
  { name: 'Yesenia M.', source: 'Google', body: 'All the ladies are so sweet. And they work as a team — I always leave happy. My blowout lasts the whole week.' },
  { name: 'Carmen R.', source: 'Google', body: 'They made me feel like a queen on my wedding day. The makeup lasted all day and every photo came out beautifully.' },
  { name: 'Mariela P.', source: 'Yelp', body: "Been going for years. Mía and her team know my hair like nobody else. I won't go anywhere else." },
  { name: 'Joselyn T.', source: 'Google', body: "Walk-in and they always get me in fast. My blowout lasts the whole week. I recommend them to all my friends." },
  { name: 'Andrea S.', source: 'Facebook', body: "Best color I've ever had in my life. They know how to protect the hair — no burn, no damage. Real Pravana." },
  { name: 'Linette V.', source: 'Google', body: 'They did my extensions for my quinceañera. Looked natural, soft, and my mom cried with joy. Thank you, Mía.' },
];

const galleryItems = [
  { src: 'mia-1.jpg', cat: 'blowout', label: 'Dominican Blowout' },
  { src: 'mia-2.jpg', cat: 'color', label: 'Color & Highlights' },
  { src: 'mia-3.jpg', cat: 'bridal', label: 'Bridal' },
  { src: 'mia-4.jpg', cat: 'blowout', label: 'Dominican Blowout' },
  { src: 'mia-5.jpg', cat: 'color', label: 'Color' },
  { src: 'mia-6.jpg', cat: 'extensions', label: 'Extensions' },
  { src: 'mia-7.jpg', cat: 'cuts', label: 'Cuts' },
  { src: 'mia-8.jpg', cat: 'blowout', label: 'Dominican Blowout' },
];

const galleryFilters = [
  { id: 'all', label: 'All' },
  { id: 'blowout', label: 'Blowout' },
  { id: 'color', label: 'Color' },
  { id: 'bridal', label: 'Bridal' },
  { id: 'extensions', label: 'Extensions' },
  { id: 'cuts', label: 'Cuts' },
];

const faqs = [
  { q: 'Do I need an appointment?', a: "No — we take walk-ins first come, first served. For longer services (bridal, full color, extensions) we recommend calling ahead to reserve a time." },
  { q: 'What are the best days to come in?', a: 'Tuesday through Thursday are our slowest days. Friday and Saturday are busiest — we still get you in, but wait can be longer. Earlier is better.' },
  { q: 'Do you work with all hair types?', a: 'Yes. We specialize in Dominican hair — curls, waves, mixed textures, fine, thick, color-treated, all of it. Decades of experience with every type.' },
  { q: 'How long does a Dominican blowout last?', a: 'With basic care (silk cap at night, no getting it wet) our Dominican blowout lasts the whole week — many clients get 10 days.' },
  { q: 'Do you do bridal and large events?', a: 'Yes. For bridal, book your date in advance (ideally 4-8 weeks). We offer makeup and hair trials. Call to talk through your day.' },
  { q: 'What payment do you accept?', a: 'Cash and credit card (Visa, Mastercard, Amex). If you have questions, call before you come.' },
  { q: 'Is there parking?', a: 'Yes — free street parking and nearby lots on S Broadway. Easy to find in the heart of Lawrence.' },
  { q: 'Do you speak English?', a: 'Yes. The whole team is bilingual — English and Spanish. We serve clients from Lawrence, Methuen, Andover, Haverhill, Lowell, and Salem NH.' },
];
---

<Base lang="en" pathEs="/" pathEn="/en/">
  <header class="topbar">
    <div class="container topbar-row">
      <a class="brand" href="#top" aria-label="Mía Beauty Boutique">
        <Logo size="md" />
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#why" data-nav>Why Mía</a>
        <a href="#services" data-nav>Services</a>
        <a href="#gallery" data-nav>Gallery</a>
        <a href="#reviews" data-nav>Reviews</a>
        <a href="#faq" data-nav>FAQ</a>
        <a href="#visit" data-nav>Visit</a>
      </nav>
      <div class="topbar-right">
        <a class="lang-switch" href={BASE} hreflang="es" aria-label="Ver en español">ES</a>
        <a class="topbar-call" href={`tel:${phoneTel}`}>{phone}</a>
      </div>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Lawrence, MA · 40+ years making women feel beautiful</span>
        <h1>Where Dominican hair <em>shines</em>.</h1>
        <p class="hero-lede">
          Mía Beauty Boutique is a family-run salon in Lawrence, MA — over four decades perfecting the Dominican blowout, color, bridal, and everything that makes you look exactly how you want to look.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call the Salon</a>
          <a class="btn btn-gold" href={directionsUrl} target="_blank" rel="noopener">Get Directions</a>
          <a class="btn btn-ghost" href="#gallery">See Gallery</a>
        </div>
        <ul class="hero-stats">
          <li><strong>40+</strong><span>years of experience</span></li>
          <li><strong>Walk-ins</strong><span>first come, first served</span></li>
          <li><strong>Bilingual</strong><span>english · español</span></li>
          <li><strong>Family</strong><span>3 generations</span></li>
        </ul>
      </div>
      <div class="hero-photo">
        <img src={img('mia-1.jpg')} alt="Featured work from Mía Beauty Boutique" loading="eager" />
        <div class="hero-badge">
          <strong>40+</strong>
          <span>years in Lawrence</span>
        </div>
      </div>
    </div>
  </section>

  <section class="why" id="why">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why Mía</span>
        <h2>What you won't find at another salon.</h2>
        <p class="section-sub">Decades of Dominican craft, a family atmosphere, and results that last. This is what makes us different.</p>
      </div>
      <div class="why-grid">
        {whyMia.map((w, i) => (
          <article class="why-card" style={`--i: ${i}`}>
            <div class="why-num">0{i + 1}</div>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="services" id="services">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Services</span>
        <h2>Everything your beauty needs.</h2>
        <p class="section-sub">Specialists in Dominican hair. Plus makeup, bridal, threading, and more. Starting prices shown — call to confirm.</p>
      </div>
      <div class="service-grid">
        {services.map((s, i) => (
          <article class="service-card" style={`--i: ${i}`}>
            <span class="service-mark">{s.icon}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <span class="service-price">{s.price}</span>
          </article>
        ))}
      </div>
      <div class="services-cta">
        <p>Don't see your service? Call us — we probably do it.</p>
        <div class="services-cta-row">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
          <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener">Get Directions</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="container about-grid">
      <div class="about-photo">
        <img src={img('mia-2.jpg')} alt="The Mía Beauty Boutique team" loading="lazy" />
      </div>
      <div class="about-copy">
        <span class="kicker">About</span>
        <h2>Four decades making you feel at home.</h2>
        <p>
          Mía Beauty Boutique is a family-run Dominican salon in the heart of Lawrence. We've been serving three generations of clients for over 40 years — grandmothers, mothers, daughters, and now granddaughters.
        </p>
        <p>
          What makes Mía special isn't just the technique — though the technique is there. It's the atmosphere: the team that works together, the coffee while you wait, the conversations in Spanish, the kind of attention that makes you feel like family.
        </p>
        <div class="stylists">
          {stylists.map((s) => (
            <div class="stylist">
              <h4>{s.name}</h4>
              <span class="stylist-role">{s.role}</span>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <p class="about-pull">
          The promise: when you leave here, you feel more beautiful, more cared for, and more like yourself.
        </p>
      </div>
    </div>
  </section>

  <section class="work" id="gallery">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Gallery</span>
        <h2>Our work.</h2>
        <p class="section-sub">Filter by category · Tap any photo to view full size.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filter gallery">
        {galleryFilters.map((f, i) => (
          <button
            class={`filter-btn${i === 0 ? ' is-active' : ''}`}
            data-filter={f.id}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
      <div class="work-grid" id="gallery-grid">
        {galleryItems.map((w, i) => (
          <figure
            class="work-card"
            data-cat={w.cat}
            style={`--i: ${i}`}
            data-src={img(w.src)}
            data-label={w.label}
            tabindex="0"
            role="button"
            aria-label={`View ${w.label} full size`}
          >
            <img src={img(w.src)} alt={w.label} loading="lazy" />
            <figcaption>{w.label}</figcaption>
          </figure>
        ))}
      </div>
      <p class="gallery-note">Follow us on <a href={instagramUrl} target="_blank" rel="noopener">Instagram</a> for new photos every week.</p>
    </div>
  </section>

  <section class="reviews" id="reviews">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Reviews</span>
        <h2>What our clients say.</h2>
        <p class="section-sub">Real reviews from Google, Yelp, and Facebook.</p>
      </div>
      <div class="review-grid">
        {reviews.map((r, i) => (
          <article class="review-card" style={`--i: ${i}`}>
            <div class="stars" aria-label="5 stars">★★★★★</div>
            <blockquote>{r.body}</blockquote>
            <cite>— {r.name} <span class="review-source">· {r.source}</span></cite>
          </article>
        ))}
      </div>
      <div class="reviews-cta">
        <a class="btn btn-primary" href={reviewsUrl} target="_blank" rel="noopener">Read more reviews</a>
        <a class="btn btn-ghost" href={writeReviewUrl} target="_blank" rel="noopener">Leave a review</a>
      </div>
    </div>
  </section>

  <section class="social" id="social">
    <div class="container social-inner">
      <div class="social-copy">
        <span class="kicker">Follow</span>
        <h2>New transformations every week.</h2>
        <p>Color, blowouts, bridal, before-and-afters — all on our Instagram. Follow for the salon's latest work.</p>
        <div class="social-cta">
          <a class="btn btn-primary" href={instagramUrl} target="_blank" rel="noopener">Follow on Instagram</a>
          <a class="btn btn-ghost" href={facebookUrl} target="_blank" rel="noopener">Facebook</a>
        </div>
        <span class="ig-handle">@miabeautyboutique264</span>
      </div>
      <div class="social-grid">
        {galleryItems.slice(0, 6).map((w, i) => (
          <a class="social-tile" href={instagramUrl} target="_blank" rel="noopener" aria-label="View on Instagram" style={`--i: ${i}`}>
            <img src={img(w.src)} alt={w.label} loading="lazy" />
            <span class="social-overlay" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Questions</span>
        <h2>Everything you want to know before your visit.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" style={`--i: ${i}`}>
            <summary>
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="visit" id="visit">
    <div class="container visit-inner">
      <span class="kicker light">Visit Us</span>
      <h2>We're waiting for you in Lawrence.</h2>
      <div class="visit-grid">
        <div class="visit-info">
          <ul class="visit-list">
            <li><span class="lbl">Address</span><span>{address}</span></li>
            <li><span class="lbl">Phone</span><a href={`tel:${phoneTel}`}>{phone}</a></li>
            <li><span class="lbl">Walk-ins welcome</span><span>First come, first served</span></li>
            <li><span class="lbl">Parking</span><span>Free street parking and nearby lots</span></li>
            <li><span class="lbl">Payment</span><span>Cash and card (Visa · MC · Amex)</span></li>
            <li><span class="lbl">Best days</span><span>Tuesday through Thursday — less wait</span></li>
            <li><span class="lbl">Bridal & full color</span><span>Call ahead to reserve your time</span></li>
          </ul>
          <div class="visit-ctas">
            <a class="btn btn-primary big" href={`tel:${phoneTel}`}>Call Now</a>
            <a class="btn btn-gold big" href={directionsUrl} target="_blank" rel="noopener">Get Directions</a>
          </div>
        </div>
        <div class="visit-hours">
          <h3>Hours</h3>
          <ul class="hours-list">
            <li><span>Tuesday</span><span>9:30am – 6:00pm</span></li>
            <li><span>Wednesday</span><span>9:30am – 6:00pm</span></li>
            <li><span>Thursday</span><span>9:30am – 6:00pm</span></li>
            <li><span>Friday</span><span>8:00am – 5:30pm</span></li>
            <li><span>Saturday</span><span>7:00am – 5:00pm</span></li>
            <li class="closed"><span>Sunday</span><span>Closed</span></li>
            <li class="closed"><span>Monday</span><span>Closed</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <Logo size="sm" variant="light" />
      </div>
      <div class="footer-meta">
        <a href={`tel:${phoneTel}`}>{phone}</a>
        <span class="dot">·</span>
        <span>{address}</span>
        <br />
        <a href={instagramUrl} rel="noopener" target="_blank">Instagram</a>
        <span class="dot">·</span>
        <a href={facebookUrl} rel="noopener" target="_blank">Facebook</a>
        <span class="dot">·</span>
        <a href={yelpUrl} rel="noopener" target="_blank">Yelp</a>
        <span class="dot">·</span>
        <a href={BASE} hreflang="es">Español</a>
      </div>
      <div class="footer-fineprint">© {new Date().getFullYear()} Mía Beauty Boutique · Lawrence, MA</div>
    </div>
  </footer>

  <div class="mobile-bar">
    <a class="mobile-bar-btn primary" href={`tel:${phoneTel}`} aria-label="Call the salon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>Call</span>
    </a>
    <a class="mobile-bar-btn gold" href={directionsUrl} target="_blank" rel="noopener" aria-label="Get Directions">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Directions</span>
    </a>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="Close">×</button>
    <button class="lightbox-prev" type="button" aria-label="Previous">‹</button>
    <button class="lightbox-next" type="button" aria-label="Next">›</button>
    <figure class="lightbox-figure">
      <img id="lightbox-img" alt="" />
      <figcaption id="lightbox-cap"></figcaption>
    </figure>
  </div>

  <style>
    .topbar { background: rgba(251,246,239,.78); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid transparent; position: sticky; top: 0; z-index: 50; transition: background .25s ease, border-color .25s ease, box-shadow .25s ease; }
    .topbar.scrolled { background: rgba(251,246,239,.95); border-bottom-color: var(--line); box-shadow: 0 1px 0 rgba(122,31,43,.02), 0 6px 20px rgba(122,31,43,.04); }
    .topbar-row { display: flex; align-items: center; gap: 1.5rem; padding: .65rem 1.75rem; transition: padding .25s ease; }
    .topbar.scrolled .topbar-row { padding: .45rem 1.75rem; }
    .brand { display: flex; align-items: center; }
    .brand :global(svg) { height: 72px; width: auto; }
    .nav { display: flex; gap: 1.4rem; margin-left: auto; }
    .nav a { color: var(--ink-soft); font-weight: 500; font-size: .94rem; position: relative; padding: .3rem 0; }
    .nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--burgundy); transform: scaleX(0); transform-origin: left; transition: transform .25s ease; border-radius: 2px; }
    .nav a:hover { color: var(--burgundy); opacity: 1; }
    .nav a.is-active { color: var(--burgundy); }
    .nav a.is-active::after { transform: scaleX(1); }
    .topbar-right { display: flex; align-items: center; gap: .65rem; }
    .lang-switch { padding: .45rem .75rem; border: 1px solid var(--line-2); border-radius: 999px; font-size: .78rem; font-weight: 600; letter-spacing: .08em; color: var(--burgundy); }
    .lang-switch:hover { background: var(--burgundy); color: var(--cream); opacity: 1; }
    .topbar-call { padding: .55rem 1rem; background: var(--burgundy); color: var(--cream); border-radius: 999px; font-weight: 600; font-size: .9rem; transition: background .18s ease, transform .18s ease; }
    .topbar-call:hover { background: var(--burgundy-dark); color: var(--cream); opacity: 1; transform: scale(1.03); }

    .hero { padding: 5rem 0 6rem; background: var(--cream); position: relative; overflow: hidden; }
    .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 85% 15%, rgba(184,137,63,.1), transparent 50%), radial-gradient(circle at 15% 85%, rgba(240,212,204,.18), transparent 50%); pointer-events: none; }
    .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 3.5rem; align-items: center; position: relative; }
    .eyebrow { display: inline-block; font-size: .78rem; font-weight: 600; color: var(--gold); letter-spacing: .14em; text-transform: uppercase; margin-bottom: 1.5rem; }
    .hero h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); margin-bottom: 1.4rem; max-width: 14ch; }
    .hero h1 em { font-style: italic; color: var(--gold); font-weight: 600; }
    .hero-lede { font-size: clamp(1.05rem, 1.4vw, 1.18rem); color: var(--ink-soft); max-width: 540px; margin: 0 0 2.4rem; line-height: 1.65; font-weight: 400; }
    .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 3rem; }
    .hero-stats { list-style: none; padding: 2rem 0 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; border-top: 1px solid var(--line); }
    .hero-stats li { display: flex; flex-direction: column; gap: .3rem; }
