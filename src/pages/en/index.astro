---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';

const phone = '(978) 208-7877';
const phoneTel = '+19782087877';
const address = '264 S Broadway, Lawrence, MA 01843';
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=264+S+Broadway%2C+Lawrence%2C+MA+01843';
const reviewsUrl = 'https://www.google.com/search?q=Mia+Beauty+Boutique+Lawrence+MA';
const instagramUrl = 'https://www.instagram.com/miabeautyboutique264/';
const facebookUrl = 'https://www.facebook.com/p/Mia-Beauty-Boutique-100058155380527/';
const yelpUrl = 'https://www.yelp.com/biz/mia-beauty-boutique-lawrence-2';

const BASE = import.meta.env.BASE_URL;
const ownerImg = (name: string) => `${BASE}images/owner/2026-05-27/${name}`;

const focusServices = [
  { title: 'Dominican Blowout', icon: '✦', body: 'Our most requested service, with shine, movement, and a finish many clients still love all week.' },
  { title: 'Color & Highlights', icon: '✦', body: 'Balayage, highlights, full color, and correction, always planned around the health of the hair first.' },
  { title: 'Straightening & Keratin', icon: '✦', body: 'Smoothing and frizz-control services chosen based on texture, length, and realistic upkeep.' },
  { title: 'Extensions & Styling', icon: '✦', body: 'Extension installs, polished styling, and finishes that look strong both in person and in photos.' },
  { title: 'Bridal & Events', icon: '✦', body: 'Hair and makeup with a trial, clear planning, and looks that hold up through the full day.' },
];

const serviceGroups = [
  {
    title: 'Hair',
    intro: 'What clients ask for most in the salon.',
    items: [
      'Dominican blowout / blow dry',
      'Color services',
      'Highlights and balayage',
      'All kinds of cuts',
      'Extension installs',
      'All types of straightening',
      'All kinds of styling',
      'Treatments and repair',
    ],
  },
  {
    title: 'Beauty',
    intro: 'The details that complete the appointment in one place.',
    items: [
      'Professional makeup',
      'Bridal and event beauty',
      'Hair removal',
      'Tinting',
      'Lashes',
    ],
  },
  {
    title: 'Nails',
    intro: 'The services the owner wants to spotlight right now.',
    items: [
      'Polygel',
      'Rubber base',
      'Resin',
      'Acrylic',
      'Gel and nail art',
      'All types of pedicure',
    ],
  },
];

const whyMia = [
  { title: 'Results that last', body: 'The blowout, styling, and finish are all done so the hair still looks polished after you leave.' },
  { title: 'Honest guidance', body: 'If something needs a consultation first, we say it. If one service makes more sense than another, we say that too.' },
  { title: 'Full beauty in one visit', body: 'Hair, nails, lashes, and hair removal, all shaped with the same level of care and visual consistency.' },
  { title: 'Trusted by the community', body: 'Women from Lawrence and nearby cities come back for the balance of good service, speed, and beautiful results.' },
];

const salonPoints = [
  { name: 'Hair', role: 'blowouts · color · smoothing', body: 'From regular weekly styling to color changes and extensions, we work based on the real condition of your hair.' },
  { name: 'Beauty', role: 'nails · lashes · hair removal', body: 'We also handle the details that complete the look, without making the appointment feel rushed or improvised.' },
  { name: 'Bilingual team', role: 'english · español', body: 'The consultation stays clear, direct, and comfortable for long-time clients and first-time visits alike.' },
];

const reviews = [
  { name: 'Yesenia M.', source: 'Google', body: 'All the ladies are so sweet, and they work as a team. I always leave happy. My blowout lasts the whole week.', cat: 'blowout' },
  { name: 'Joselyn T.', source: 'Google', body: 'Walk-in and they always get me in fast. My blowout lasts the whole week. I recommend them to all my friends.', cat: 'blowout' },
  { name: 'Mariela P.', source: 'Yelp', body: 'Been going for years. They know my hair like nobody else. I will not go anywhere else.', cat: 'blowout' },
  { name: 'Carmen R.', source: 'Google', body: 'They made me feel like a queen on my wedding day. The makeup lasted all day and every photo came out beautifully.', cat: 'bridal' },
  { name: 'Linette V.', source: 'Google', body: 'They did my extensions for my quinceañera. It looked natural, soft, and my mom cried with joy.', cat: 'bridal' },
  { name: 'Andrea S.', source: 'Facebook', body: 'Best color I have ever had in my life. They know how to protect the hair, no burn, no damage.', cat: 'color' },
];

const reviewFilters = [
  { id: 'all', label: 'All' },
  { id: 'blowout', label: 'Blowout & care' },
  { id: 'bridal', label: 'Bridal & events' },
  { id: 'color', label: 'Color' },
];

const galleryItems = [
  { src: 'gallery-blower-curls.jpg', cat: 'blowout', label: 'Dominican Blowout' },
  { src: 'gallery-color-balayage.jpg', cat: 'color', label: 'Caramel Balayage' },
  { src: 'gallery-blower-golden.jpg', cat: 'blowout', label: 'Dominican Blowout' },
  { src: 'gallery-color-red.jpg', cat: 'color', label: 'Red Color' },
  { src: 'gallery-extensions-detail.jpg', cat: 'extensions', label: 'Extensions' },
  { src: 'gallery-cut-pixie.jpg', cat: 'cuts', label: 'Pixie Cut' },
  { src: 'gallery-color-red-black.jpg', cat: 'color', label: 'Red Highlights' },
  { src: 'gallery-cut-platinum.jpg', cat: 'cuts', label: 'Platinum Cut' },
];

const galleryFilters = [
  { id: 'all', label: 'All' },
  { id: 'blowout', label: 'Blowout' },
  { id: 'color', label: 'Color' },
  { id: 'extensions', label: 'Extensions' },
  { id: 'cuts', label: 'Cuts' },
];

const socialHighlights = [
  'Fresh transformations every week',
  'Ideas for bridal, color, and blowouts',
  'Nails, lashes, and everyday salon details',
];

const socialNotes = [
  { title: 'What you will see', body: 'Real results, short videos, and work that just came out of the salon.' },
  { title: 'Why it helps', body: 'If you are coming in for color, bridal, blowouts, or nails, that is where the newest work shows up first.' },
  { title: 'How to reach out', body: 'Save the photo you like and send it over on Instagram, or call us to talk through it.' },
];

const faqs = [
  { q: 'Do I need an appointment?', a: 'No. Walk-ins are welcome and we take clients first come, first served. For longer services, like bridal, full color, or extensions, we recommend calling ahead.' },
  { q: 'Why are there no exact prices on the website?', a: 'Because the final cost changes with hair length, density, design, touch-up needs, or a full transformation. We would rather quote you well once we know what you actually want.' },
  { q: 'Do I need a consultation before bridal or full color?', a: 'Yes, it is worth calling first so the plan is clear. For brides, we do a trial for hair and makeup. For full color or correction, we prefer to see the hair or talk through it first.' },
  { q: 'Do you require a deposit for brides?', a: 'To hold the date we ask for a small deposit, and it gets applied to the total later. Every wedding is different, so call us and we will walk you through it.' },
  { q: 'What are the best days to come in?', a: 'Tuesday through Thursday are the calmest days. Friday and Saturday are busiest. Earlier is better.' },
  { q: 'Do you work with all hair types?', a: 'Yes. We specialize in Dominican hair, curls, waves, mixed textures, fine hair, thick hair, and color-treated hair. Each texture gets the right technique.' },
  { q: 'Do you do nails too?', a: 'Yes. We offer polygel, rubber base, resin, acrylic, gel, nail art, and all types of pedicure. You can do hair and nails in the same visit.' },
  { q: 'How long does a Dominican blowout last?', a: 'With basic care, like a night wrap and keeping it dry, many clients still feel good about it all week, and some stretch it to 10 days.' },
  { q: 'Do you handle bridal parties and larger events?', a: 'Yes. For bridal, reserve your date in advance. We offer a trial and help you plan the beauty schedule for the day.' },
  { q: 'What payment methods do you accept?', a: 'Cash and credit card, Visa, Mastercard, and Amex. If you have a very specific question, call before you come in.' },
  { q: 'Is there parking?', a: 'Yes. There is free street parking and nearby lots on S Broadway. The salon is easy to find.' },
  { q: 'Do you speak Spanish?', a: 'Yes. The whole team works in English and Spanish. We welcome clients from Lawrence, Methuen, Andover, Haverhill, Lowell, and Salem, NH.' },
];
---

<Base lang="en" pathEs="/" pathEn="/en/">
  <header class="topbar">
    <div class="container topbar-row">
      <a class="brand" href="#top" aria-label="Mia Beauty Boutique">
        <Logo size="md" />
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#marilyn" data-nav>Story</a>
        <a href="#why" data-nav>Why Mia</a>
        <a href="#services" data-nav>Services</a>
        <a href="#gallery" data-nav>Gallery</a>
        <a href="#reviews" data-nav>Reviews</a>
        <a href="#faq" data-nav>FAQ</a>
        <a href="#visit" data-nav>Visit</a>
      </nav>
      <div class="topbar-right">
        <a class="lang-switch" href={BASE} hreflang="es" aria-label="Ver en español">ES</a>
        <a class="topbar-call" href={`tel:${phoneTel}`}>{phone}</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
          <span class="menu-toggle-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span>Menu</span>
        </button>
      </div>
    </div>
    <div class="topbar-progress" aria-hidden="true"><span></span></div>
    <div class="mobile-menu" id="mobile-menu" hidden>
      <div class="mobile-menu-inner">
        <a href="#marilyn" data-nav>Story</a>
        <a href="#why" data-nav>Why Mia</a>
        <a href="#services" data-nav>Services</a>
        <a href="#gallery" data-nav>Gallery</a>
        <a href="#reviews" data-nav>Reviews</a>
        <a href="#faq" data-nav>FAQ</a>
        <a href="#visit" data-nav>Visit</a>
        <a class="mobile-menu-call" href={`tel:${phoneTel}`}>Call the salon</a>
      </div>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Lawrence, MA · over 30 years of salon experience</span>
        <h1>Gloss, movement, and beauty done well.</h1>
        <p class="hero-lede">
          Mia Beauty Boutique is the salon for clients who want blowouts, color, nails, and beauty services with a polished finish, warm care, and an appointment that feels well run from start to finish.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call the Salon</a>
          <a class="btn btn-gold" href={directionsUrl} target="_blank" rel="noopener">Get Directions</a>
          <a class="btn btn-ghost" href="#services">View Services</a>
        </div>
        <ul class="hero-stats">
          <li><strong>30+ years</strong><span>serving Lawrence</span></li>
          <li><strong>Walk-ins</strong><span>for everyday visits</span></li>
          <li><strong>Bilingual</strong><span>english · español</span></li>
          <li><strong>Consults</strong><span>bridal · color · extensions</span></li>
        </ul>
      </div>
      <div class="hero-photo">
        <img src={ownerImg('gallery-blower-curls.jpg')} alt="Featured Dominican blowout work at Mia Beauty Boutique" loading="eager" />
        <div class="hero-badge hero-badge--phrase">
          <span>Hair · nails · beauty</span>
        </div>
      </div>
    </div>
  </section>

  <section class="founder" id="marilyn">
    <div class="container founder-grid">
      <div class="founder-photo">
        <img src={ownerImg('founder-placeholder.jpg')} alt="Color and polished finish work at Mia Beauty Boutique" loading="lazy" />
      </div>
      <div class="founder-copy">
        <span class="kicker">Marilyn's vision</span>
        <h2>A salon built so you leave looking polished, not just done.</h2>
        <p>
          Marilyn built Mia Beauty Boutique around one simple idea: combine technique, warm service, and results that still look beautiful after the appointment is over.
        </p>
        <p>
          The salon is named after her daughter, Mia, and that mix of care, discipline, and pride in doing the work well still shapes how the team serves clients today.
        </p>
        <span class="founder-sig">Marilyn · founder</span>
      </div>
    </div>
  </section>

  <section class="why" id="why">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Why Mia</span>
        <h2>What feels different to a client the moment she walks in.</h2>
        <p class="section-sub">We are not trying to sound like every salon. The site should feel the way the appointment feels: cared for, clear, and focused on results.</p>
      </div>
      <div class="why-grid">
        {whyMia.map((w, i) => (
          <article class="why-card" style={`--i: ${i}`}>
            <div class="why-num">0{i + 1}</div>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="services" id="services">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Services</span>
        <h2>The most requested services, without a confusing price menu.</h2>
        <p class="section-sub">We removed prices from the site because the final cost depends on length, density, design, and the real time involved. If you want a real quote, call us.</p>
      </div>

      <div class="signature-grid">
        {focusServices.map((s, i) => (
          <article class="signature-card" style={`--i: ${i}`}>
            <span class="service-mark">{s.icon}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>

      <div class="services-columns">
        {serviceGroups.map((group, i) => (
          <article class="service-group" style={`--i: ${i}`}>
            <h3>{group.title}</h3>
            <p>{group.intro}</p>
            <ul class="service-tag-list">
              {group.items.map((item) => (
                <li class="service-tag">{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="services-cta" id="consulta">
        <div class="services-cta-card walk-in">
          <h4>An everyday visit?</h4>
          <p>Walk-ins are welcome, first come first served. Call if you want to check how the wait looks today.</p>
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Call {phone}</a>
        </div>
        <div class="services-cta-card premium">
          <h4>Bridal, full color, or a transformation?</h4>
          <p>Call us before the appointment so the plan is clear and the day does not feel improvised.</p>
          <a class="btn btn-gold" href={`tel:${phoneTel}`}>Call for consultation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about" id="about">
    <div class="container about-grid">
      <div class="about-photo">
        <img src={ownerImg('about-salon.jpg')} alt="Color and blow dry work at Mia Beauty Boutique" loading="lazy" />
      </div>
      <div class="about-copy">
        <span class="kicker">Your visit</span>
        <h2>Every service is shaped around your hair, your timing, and the result you want.</h2>
        <p>
          We do not use a rigid website price list because a blowout, color service, or pedicure is not priced the same for every client. Length, density, design, and real service time matter.
        </p>
        <p>
          That is why the website shows clearly what the salon does, and the final quote happens once we know what you actually need.
        </p>
        <div class="stylists">
          {salonPoints.map((s) => (
            <div class="stylist">
              <h4>{s.name}</h4>
              <span class="stylist-role">{s.role}</span>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <p class="about-pull">
          If you are coming in for color, bridal, extensions, or a bigger change, call first and we will set it up well.
        </p>
      </div>
    </div>
  </section>

  <section class="work" id="gallery">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Gallery</span>
        <h2>Real salon work.</h2>
        <p class="section-sub">Filter by category and tap any photo to view it larger.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filter gallery">
        {galleryFilters.map((f, i) => (
          <button
            class={`filter-btn${i === 0 ? ' is-active' : ''}`}
            data-filter={f.id}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
      <div class="work-grid" id="gallery-grid">
        {galleryItems.map((w, i) => {
          const path = ownerImg(w.src);
          return (
            <figure
              class="work-card"
              data-cat={w.cat}
              style={`--i: ${i}`}
              data-src={path}
              data-label={w.label}
              tabindex="0"
              role="button"
              aria-label={`View ${w.label} full size`}
            >
              <img src={path} alt={w.label} loading="lazy" />
              <figcaption>{w.label}</figcaption>
            </figure>
          );
        })}
      </div>
      <p class="gallery-note">Follow us on <a href={instagramUrl} target="_blank" rel="noopener">Instagram</a> for new work every week.</p>
    </div>
  </section>

  <section class="reviews" id="reviews">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Reviews</span>
        <h2>What clients say when they leave happy.</h2>
        <p class="section-sub">Real reviews from Google, Yelp, and Facebook, filtered around what people come in for most.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filter reviews">
        {reviewFilters.map((f, i) => (
          <button
            class={`filter-btn${i === 0 ? ' is-active' : ''}`}
            data-filter={f.id}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
      <div class="review-grid" id="review-grid">
        {reviews.map((r, i) => (
          <article class="review-card" data-cat={r.cat} style={`--i: ${i}`}>
            <div class="stars" aria-label="5 stars">★★★★★</div>
            <blockquote>{r.body}</blockquote>
            <cite>{r.name} <span class="review-source">· {r.source}</span></cite>
          </article>
        ))}
      </div>
      <div class="reviews-cta">
        <a class="btn btn-primary" href={reviewsUrl} target="_blank" rel="noopener">Read More Reviews</a>
        <a class="btn btn-ghost" href={reviewsUrl} target="_blank" rel="noopener">View Google Reviews</a>
      </div>
    </div>
  </section>

  <section class="social" id="social">
    <div class="container social-inner">
      <div class="social-copy">
        <span class="kicker">Instagram</span>
        <h2>A feed that feels as aligned as the salon itself.</h2>
        <p>That is where the newest work lives: color, blowouts, bridal, nails, and the real day-to-day details. We treat it like a living portfolio, not filler.</p>
        <div class="social-cta">
          <a class="btn btn-primary" href={instagramUrl} target="_blank" rel="noopener">Follow on Instagram</a>
          <a class="btn btn-ghost" href={facebookUrl} target="_blank" rel="noopener">Facebook</a>
        </div>
        <span class="ig-handle">@miabeautyboutique264</span>
      </div>
      <div class="social-panel">
        <div class="social-chip-list">
          {socialHighlights.map((item) => (
            <span class="social-chip">{item}</span>
          ))}
        </div>
        <div class="social-note-list">
          {socialNotes.map((note, i) => (
            <article class="social-note" style={`--i: ${i}`}>
              <h3>{note.title}</h3>
              <p>{note.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Questions</span>
        <h2>Everything you may want to know before coming in.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" style={`--i: ${i}`}>
            <summary>
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="worth-drive">
    <div class="container worth-inner">
      <span class="kicker">Clients come from all around</span>
      <h3>Lawrence, Methuen, Andover, Haverhill, Lowell, and Salem, NH.</h3>
      <p>The drive is worth it, the technique is worth it, and the care is worth it.</p>
    </div>
  </section>

  <section class="visit" id="visit">
    <div class="container visit-inner">
      <span class="kicker light">Visit Us</span>
      <h2>We are ready for you in Lawrence.</h2>
      <div class="visit-grid">
        <div class="visit-info">
          <ul class="visit-list">
            <li><span class="lbl">Address</span><span>{address}</span></li>
            <li><span class="lbl">Phone</span><a href={`tel:${phoneTel}`}>{phone}</a></li>
            <li><span class="lbl">Walk-ins</span><span>First come, first served</span></li>
            <li><span class="lbl">Parking</span><span>Free street parking and nearby lots</span></li>
            <li><span class="lbl">Payment</span><span>Cash and card, Visa · MC · Amex</span></li>
            <li><span class="lbl">Best days</span><span>Tuesday through Thursday, shorter waits</span></li>
            <li><span class="lbl">Bridal and full color</span><span>Call ahead to set your time well</span></li>
          </ul>
          <div class="visit-ctas">
            <a class="btn btn-primary big" href={`tel:${phoneTel}`}>Call Now</a>
            <a class="btn btn-gold big" href={directionsUrl} target="_blank" rel="noopener">Get Directions</a>
          </div>
        </div>
        <div class="visit-hours">
          <h3>Hours</h3>
          <ul class="hours-list">
            <li><span>Tuesday</span><span>9:30am – 6:00pm</span></li>
            <li><span>Wednesday</span><span>9:30am – 6:00pm</span></li>
            <li><span>Thursday</span><span>9:30am – 6:00pm</span></li>
            <li><span>Friday</span><span>8:00am – 5:30pm</span></li>
            <li><span>Saturday</span><span>7:00am – 5:00pm</span></li>
            <li class="closed"><span>Sunday</span><span>Closed</span></li>
            <li class="closed"><span>Monday</span><span>Closed</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <Logo size="sm" variant="light" />
      </div>
      <div class="footer-meta">
        <a href={`tel:${phoneTel}`}>{phone}</a>
        <span class="dot">·</span>
        <span>{address}</span>
        <br />
        <a href={instagramUrl} rel="noopener" target="_blank">Instagram</a>
        <span class="dot">·</span>
        <a href={facebookUrl} rel="noopener" target="_blank">Facebook</a>
        <span class="dot">·</span>
        <a href={yelpUrl} rel="noopener" target="_blank">Yelp</a>
        <span class="dot">·</span>
        <a href={BASE} hreflang="es">Español</a>
      </div>
      <div class="footer-fineprint">© {new Date().getFullYear()} Mia Beauty Boutique · Lawrence, MA</div>
    </div>
  </footer>

  <div class="mobile-bar">
    <a class="mobile-bar-btn primary" href={`tel:${phoneTel}`} aria-label="Call the salon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>Call</span>
    </a>
    <a class="mobile-bar-btn gold" href={directionsUrl} target="_blank" rel="noopener" aria-label="Get directions">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Directions</span>
    </a>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="Close">×</button>
    <button class="lightbox-prev" type="button" aria-label="Previous">‹</button>
    <button class="lightbox-next" type="button" aria-label="Next">›</button>
    <figure class="lightbox-figure">
      <img id="lightbox-img" alt="" />
      <figcaption id="lightbox-cap"></figcaption>
    </figure>
  </div>

  <style>
    .topbar { background: rgba(251,246,239,.82); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid transparent; position: sticky; top: 0; z-index: 50; transition: background .25s ease, border-color .25s ease, box-shadow .25s ease; }
    .topbar.scrolled { background: rgba(251,246,239,.95); border-bottom-color: var(--line); box-shadow: 0 1px 0 rgba(122,31,43,.02), 0 6px 20px rgba(122,31,43,.04); }
    .topbar-row { display: flex; align-items: center; gap: 1.5rem; padding: .65rem 1.75rem; transition: padding .25s ease; position: relative; }
    .topbar.scrolled .topbar-row { padding: .45rem 1.75rem; }
    .topbar-progress { height: 2px; background: rgba(122,31,43,.08); transform-origin: left; overflow: hidden; }
    .topbar-progress span { display: block; height: 100%; width: 100%; transform: scaleX(0); transform-origin: left; background: linear-gradient(90deg, rgba(184,137,63,.8), rgba(122,31,43,.95)); transition: transform .14s linear; }
    .brand { display: flex; align-items: center; }
    .brand :global(svg) { height: 72px; width: auto; }
    .nav { display: flex; gap: 1.4rem; margin-left: auto; }
    .nav a { color: var(--ink-soft); font-weight: 500; font-size: .94rem; position: relative; padding: .3rem 0; }
    .nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--burgundy); transform: scaleX(0); transform-origin: left; transition: transform .25s ease; border-radius: 2px; }
    .nav a:hover { color: var(--burgundy); opacity: 1; }
    .nav a.is-active { color: var(--burgundy); }
    .nav a.is-active::after { transform: scaleX(1); }
    .topbar-right { display: flex; align-items: center; gap: .65rem; }
    .lang-switch { padding: .45rem .75rem; border: 1px solid var(--line-2); border-radius: 999px; font-size: .78rem; font-weight: 600; letter-spacing: .08em; color: var(--burgundy); }
    .lang-switch:hover { background: var(--burgundy); color: var(--cream); opacity: 1; }
    .topbar-call { padding: .55rem 1rem; background: var(--burgundy); color: var(--cream); border-radius: 999px; font-weight: 600; font-size: .9rem; letter-spacing: -0.005em; transition: background .18s ease, transform .18s ease; }
    .topbar-call:hover { background: var(--burgundy-dark); color: var(--cream); opacity: 1; transform: scale(1.03); }
    .menu-toggle { display: none; align-items: center; gap: .65rem; padding: .55rem .85rem; border-radius: 999px; border: 1px solid var(--line); background: var(--cream); color: var(--burgundy); font: inherit; font-weight: 600; cursor: pointer; }
    .menu-toggle-lines { display: inline-flex; flex-direction: column; gap: 3px; }
    .menu-toggle-lines span { width: 16px; height: 2px; background: currentColor; border-radius: 999px; display: block; }
    .mobile-menu { display: none; position: absolute; top: calc(100% + .55rem); left: 1rem; right: 1rem; z-index: 55; }
    .mobile-menu[hidden] { display: none !important; }
    .mobile-menu-inner { background: rgba(251,246,239,.98); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 22px 50px rgba(42,26,29,.15); padding: 1rem; display: grid; gap: .35rem; }
    .mobile-menu-inner a { padding: .8rem .9rem; border-radius: 12px; color: var(--ink); font-weight: 600; }
    .mobile-menu-inner a:hover, .mobile-menu-inner a.is-active { background: var(--cream-2); color: var(--burgundy); opacity: 1; }
    .mobile-menu-call { margin-top: .35rem; background: var(--burgundy); color: var(--cream) !important; text-align: center; }

    .hero { padding: 5rem 0 6rem; background: var(--cream); position: relative; overflow: hidden; }
    .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 85% 15%, rgba(184,137,63,.1), transparent 50%), radial-gradient(circle at 15% 85%, rgba(240,212,204,.18), transparent 50%); pointer-events: none; }
    .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 3.5rem; align-items: center; position: relative; }
    .eyebrow { display: inline-block; font-size: .78rem; font-weight: 600; color: var(--gold); letter-spacing: .14em; text-transform: uppercase; margin-bottom: 1.5rem; }
    .hero h1 { font-size: clamp(2.8rem, 6vw, 4.8rem); margin-bottom: 1.4rem; max-width: 11ch; }
    .hero-lede { font-size: clamp(1.05rem, 1.4vw, 1.18rem); color: var(--ink-soft); max-width: 560px; margin: 0 0 2.4rem; line-height: 1.65; font-weight: 400; }
    .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 3rem; }
    .hero-stats { list-style: none; padding: 2rem 0 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; border-top: 1px solid var(--line); }
    .hero-stats li { display: flex; flex-direction: column; gap: .3rem; }
    .hero-stats strong { font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 1.9rem; color: var(--burgundy); line-height: 1; }
    .hero-stats span { font-size: .78rem; color: var(--ink-muted); letter-spacing: .01em; }
    .hero-photo { position: relative; max-width: 520px; justify-self: end; padding: 1rem; isolation: isolate; }
    .hero-photo::before { content: ''; position: absolute; inset: 1.2rem 0 0 1.2rem; border-radius: 28px; background: linear-gradient(180deg, rgba(240,212,204,.55), rgba(184,137,63,.1)); z-index: -2; }
    .hero-photo::after { content: ''; position: absolute; inset: 0; border-radius: 30px; border: 1px solid rgba(184,137,63,.28); z-index: -1; pointer-events: none; }
    .hero-photo img { width: 100%; border-radius: 22px; aspect-ratio: 4 / 5; object-fit: cover; box-shadow: 0 22px 60px rgba(122,31,43,.16), 0 2px 6px rgba(122,31,43,.06); transition: transform .45s cubic-bezier(0.22,0.61,0.36,1), box-shadow .45s ease; }
    .hero-photo:hover img { transform: translateY(-6px) scale(1.015); box-shadow: 0 28px 70px rgba(122,31,43,.2), 0 4px 12px rgba(122,31,43,.08); }
    .hero-badge { position: absolute; bottom: .2rem; left: -.2rem; background: rgba(251,246,239,.92); padding: .9rem 1.2rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(122,31,43,.18); border: 1px solid var(--line); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
    .hero-badge--phrase span { font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; color: var(--burgundy); font-style: italic; letter-spacing: .02em; font-weight: 600; }

    .section-head { text-align: center; max-width: 760px; margin: 0 auto 3.5rem; }
    .kicker { font-size: .74rem; font-weight: 600; color: var(--gold); letter-spacing: .14em; text-transform: uppercase; display: inline-block; margin-bottom: 1.1rem; }
    .kicker.light { color: #d4a960; }
    .section-head h2 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: .9rem; max-width: 19ch; margin-left: auto; margin-right: auto; }
    .section-sub { color: var(--ink-soft); font-size: 1.05rem; margin: 0 auto; max-width: 620px; }
    .section-head::after { content: ''; display: block; width: 86px; height: 1px; margin: 1.35rem auto 0; background: linear-gradient(90deg, transparent, rgba(184,137,63,.88), transparent); }

    .founder { padding: 5rem 0; background: var(--cream-2); border-top: 1px solid var(--line); }
    .founder-grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: 3.5rem; align-items: center; }
    .founder-photo img { border-radius: 16px; aspect-ratio: 4 / 5; object-fit: cover; box-shadow: 0 14px 40px rgba(122,31,43,.13); }
    .founder-copy h2 { font-size: clamp(2rem, 3.8vw, 2.9rem); margin-bottom: 1.2rem; max-width: 14ch; }
    .founder-copy p { font-size: 1.06rem; color: var(--ink-soft); line-height: 1.75; margin: 0 0 1rem; }
    .founder-sig { display: inline-block; margin-top: .8rem; font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--burgundy); font-size: 1.2rem; }

    .why { padding: 6rem 0; background: var(--cream); position: relative; }
    .why::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--line-2), transparent); }
    .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.6rem; }
    .why-card { background: linear-gradient(180deg, rgba(251,246,239,.96), rgba(245,236,223,.92)); border: 1px solid var(--line); border-radius: 16px; padding: 2.2rem 1.8rem 2rem; position: relative; transition: transform .3s cubic-bezier(0.22,0.61,0.36,1), box-shadow .3s ease, border-color .3s ease; }
    .why-card:hover { transform: translateY(-6px); box-shadow: 0 14px 36px rgba(122,31,43,.1); border-color: var(--line-2); }
    .why-num { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: var(--gold); font-weight: 600; margin-bottom: .9rem; letter-spacing: .04em; }
    .why-card h3 { font-size: 1.3rem; margin-bottom: .6rem; }
    .why-card p { color: var(--ink-soft); margin: 0; font-size: .96rem; line-height: 1.65; }

    .services { padding: 6rem 0; background: var(--cream-2); }
    .signature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.15rem; margin-bottom: 2rem; }
    .signature-card { background: linear-gradient(180deg, rgba(251,246,239,.98), rgba(248,240,231,.94)); border: 1px solid var(--line-2); border-radius: 18px; padding: 2rem 1.6rem; box-shadow: 0 2px 8px rgba(122,31,43,.04); transition: transform .25s cubic-bezier(0.22,0.61,0.36,1), box-shadow .25s ease, border-color .25s ease; display: flex; flex-direction: column; }
    .signature-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(122,31,43,.11); border-color: rgba(184,137,63,.32); }
    .service-mark { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; color: var(--gold); display: block; margin-bottom: .7rem; }
    .signature-card h3 { font-size: 1.55rem; margin-bottom: .6rem; }
    .signature-card p { color: var(--ink-soft); margin: 0; font-size: .98rem; line-height: 1.62; }
    .services-columns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 3rem; }
    .service-group { background: var(--cream); border: 1px solid var(--line); border-radius: 16px; padding: 1.7rem 1.5rem; transition: transform .25s cubic-bezier(0.22,0.61,0.36,1), box-shadow .25s ease, border-color .25s ease; }
    .service-group:hover { transform: translateY(-3px); border-color: rgba(184,137,63,.28); box-shadow: 0 10px 24px rgba(122,31,43,.06); }
    .service-group h3 { font-size: 1.45rem; margin-bottom: .45rem; }
    .service-group p { margin: 0 0 1rem; color: var(--ink-soft); font-size: .94rem; }
    .service-tag-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .55rem; }
    .service-tag { padding: .55rem .8rem; border-radius: 999px; background: var(--cream-2); border: 1px solid var(--line); color: var(--ink); font-size: .88rem; transition: transform .18s ease, border-color .18s ease, background .18s ease, color .18s ease; }
    .service-tag:hover { transform: translateY(-1px); border-color: rgba(184,137,63,.35); background: rgba(240,212,204,.42); color: var(--burgundy); }
    .services-cta { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 1rem; }
    .services-cta-card { padding: 2rem 1.8rem; border-radius: 14px; }
    .services-cta-card.walk-in { background: var(--cream); border: 1px solid var(--line); }
    .services-cta-card.premium { background: var(--burgundy); color: var(--cream); }
    .services-cta-card h4 { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; margin: 0 0 .6rem; font-weight: 600; }
    .services-cta-card.premium h4 { color: var(--cream); }
    .services-cta-card p { font-size: .96rem; margin: 0 0 1.2rem; line-height: 1.6; }
    .services-cta-card.walk-in p { color: var(--ink-soft); }
    .services-cta-card.premium p { color: rgba(251,246,239,.85); }
    .services-cta-card.premium .btn-gold { background: var(--gold); color: var(--ink); }
    .services-cta-card.premium .btn-gold:hover { background: var(--gold-light); }

    .about { padding: 6rem 0; background: var(--cream); }
    .about-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 4rem; align-items: center; }
    .about-photo img { border-radius: 16px; aspect-ratio: 4 / 5; object-fit: cover; box-shadow: 0 14px 40px rgba(122,31,43,.13); }
    .about-copy h2 { font-size: clamp(1.9rem, 3.5vw, 2.7rem); margin-bottom: 1.4rem; max-width: 15ch; }
    .about-copy p { font-size: 1.05rem; color: var(--ink-soft); margin: 0 0 1.1rem; line-height: 1.7; }
    .stylists { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 1.6rem 0 1.4rem; }
    .stylist { background: var(--cream-2); border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.2rem; }
    .stylist h4 { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: var(--burgundy); margin: 0 0 .1rem; font-weight: 600; }
    .stylist-role { font-size: .78rem; color: var(--gold); letter-spacing: .1em; text-transform: uppercase; font-weight: 600; display: block; margin-bottom: .5rem; }
    .stylist p { font-size: .92rem; line-height: 1.55; margin: 0; }
    .about-pull { background: var(--blush); border-left: 3px solid var(--burgundy); padding: 1.2rem 1.4rem; border-radius: 8px; font-size: 1.1rem !important; color: var(--burgundy) !important; font-style: italic; font-family: 'Cormorant Garamond', serif !important; }

    .work { padding: 6rem 0; background: var(--cream-2); }
    .filter-bar { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; margin: -1.5rem 0 2rem; }
    .filter-btn { background: transparent; border: 1px solid var(--line-2); color: var(--ink-soft); padding: .55rem 1.1rem; border-radius: 999px; font-family: inherit; font-size: .9rem; font-weight: 500; cursor: pointer; transition: background .18s ease, color .18s ease, border-color .18s ease, transform .18s ease; }
    .filter-btn:hover { border-color: var(--burgundy); color: var(--burgundy); transform: translateY(-1px); }
    .filter-btn.is-active { background: var(--burgundy); color: var(--cream); border-color: var(--burgundy); }
    .work-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
    .work-card { margin: 0; position: relative; overflow: hidden; border-radius: 16px; aspect-ratio: 3 / 4; background: var(--blush); transition: transform .3s ease, opacity .3s ease, box-shadow .3s ease; cursor: pointer; box-shadow: 0 10px 24px rgba(122,31,43,.08); }
    .work-card.is-hidden { display: none; }
    .work-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .work-card:hover { transform: translateY(-4px); box-shadow: 0 18px 34px rgba(122,31,43,.12); }
    .work-card:hover img { transform: scale(1.06); }
    .work-card figcaption { position: absolute; inset: auto 0 0 0; background: linear-gradient(to top, rgba(42,26,29,.78), transparent); color: var(--cream); padding: 1.4rem .9rem .8rem; font-size: .84rem; font-weight: 600; letter-spacing: .02em; opacity: 0; transform: translateY(6px); transition: opacity .25s ease, transform .25s ease; }
    .work-card:hover figcaption, .work-card:focus-visible figcaption { opacity: 1; transform: translateY(0); }
    .work-card:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
    .gallery-note { text-align: center; margin: 2rem 0 0; color: var(--ink-soft); font-style: italic; font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; }
    .gallery-note a { color: var(--burgundy); font-weight: 600; font-style: normal; }

    .reviews { padding: 6rem 0; background: var(--cream); }
    .reviews .filter-bar { margin: -1rem 0 2rem; }
    .review-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
    @media (max-width: 1024px) { .review-grid { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; } }
    @media (max-width: 600px) { .review-grid { grid-template-columns: 1fr; } }
    .review-card { background: linear-gradient(180deg, rgba(251,246,239,.96), rgba(245,236,223,.92)); border: 1px solid var(--line); border-radius: 14px; padding: 1.6rem 1.4rem; transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
    .review-card:hover { transform: translateY(-4px); box-shadow: 0 10px 26px rgba(122,31,43,.08); border-color: rgba(184,137,63,.24); }
    .review-card.is-hidden { display: none; }
    .stars { color: var(--gold); font-size: .95rem; letter-spacing: .12em; margin-bottom: .85rem; white-space: nowrap; }
    .review-card blockquote { margin: 0 0 1rem; color: var(--ink); font-size: 1.02rem; line-height: 1.65; font-family: 'Cormorant Garamond', serif; font-style: italic; }
    .review-card cite { font-style: normal; font-weight: 600; color: var(--ink-soft); font-size: .9rem; }
    .review-source { color: var(--ink-muted); font-weight: 500; }
    .reviews-cta { display: flex; gap: .8rem; justify-content: center; margin-top: 2.6rem; flex-wrap: wrap; }

    .social { padding: 6rem 0; background: var(--cream-2); }
    .social-inner { display: grid; grid-template-columns: 1fr 1.05fr; gap: 3.5rem; align-items: center; }
    .social-copy h2 { font-size: clamp(1.9rem, 3.4vw, 2.5rem); margin-bottom: 1rem; max-width: 13ch; }
    .social-copy p { color: var(--ink-soft); font-size: 1.04rem; margin: 0 0 1.6rem; max-width: 460px; }
    .social-cta { display: flex; gap: .7rem; flex-wrap: wrap; margin-bottom: 1.4rem; }
    .ig-handle { font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--burgundy); font-size: 1.15rem; }
    .social-panel { background: linear-gradient(180deg, rgba(251,246,239,.88), rgba(245,236,223,.95)); border: 1px solid var(--line); border-radius: 20px; padding: 1.4rem; box-shadow: 0 14px 36px rgba(122,31,43,.08); position: relative; overflow: hidden; }
    .social-panel::before { content: ''; position: absolute; inset: 0 0 auto; height: 1px; background: linear-gradient(90deg, transparent, rgba(184,137,63,.7), transparent); }
    .social-chip-list { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: 1rem; }
    .social-chip { padding: .55rem .8rem; border-radius: 999px; background: rgba(184,137,63,.12); color: var(--burgundy); font-size: .84rem; font-weight: 600; }
    .social-note-list { display: grid; gap: .75rem; }
    .social-note { background: rgba(251,246,239,.92); border: 1px solid var(--line); border-radius: 14px; padding: 1rem 1rem 1.05rem; transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease; }
    .social-note:hover { transform: translateY(-2px); border-color: rgba(184,137,63,.28); box-shadow: 0 8px 18px rgba(122,31,43,.06); }
    .social-note h3 { font-size: 1.18rem; margin-bottom: .3rem; }
    .social-note p { margin: 0; color: var(--ink-soft); font-size: .92rem; }
    .reveal-ready { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s cubic-bezier(0.22,0.61,0.36,1); }
    .reveal-ready.is-visible { opacity: 1; transform: translateY(0); }

    @media (prefers-reduced-motion: reduce) {
      .topbar-progress span,
      .hero-photo img,
      .why-card,
      .signature-card,
      .service-group,
      .service-tag,
      .work-card,
      .work-card img,
      .review-card,
      .social-note,
      .reveal-ready {
        transition: none !important;
      }
    }

    .faq { padding: 6rem 0; background: var(--cream); }
    .faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: .65rem; }
    .faq-item { background: var(--cream-2); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; transition: border-color .2s ease, box-shadow .2s ease; }
    .faq-item[open] { border-color: var(--line-2); box-shadow: 0 6px 22px rgba(122,31,43,.07); }
    .faq-item summary { list-style: none; cursor: pointer; padding: 1.15rem 1.4rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-weight: 600; color: var(--burgundy); font-size: 1.05rem; font-family: 'Cormorant Garamond', serif; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-icon { font-size: 1.5rem; font-weight: 400; color: var(--gold); transition: transform .25s ease; line-height: 1; }
    .faq-item[open] .faq-icon { transform: rotate(45deg); }
    .faq-body { padding: 0 1.4rem 1.3rem; }
    .faq-body p { margin: 0; color: var(--ink-soft); font-size: .98rem; line-height: 1.65; }

    .worth-drive { padding: 3.5rem 0; background: var(--cream); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: center; }
    .worth-inner { max-width: 680px; margin: 0 auto; }
    .worth-drive h3 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin: .4rem auto 1rem; color: var(--burgundy); max-width: 24ch; }
    .worth-drive p { color: var(--ink-soft); margin: 0; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.15rem; }

    .visit { padding: 6rem 0; background: var(--burgundy); color: var(--cream); }
    .visit-inner { text-align: center; }
    .visit h2 { color: var(--cream); font-size: clamp(2rem, 4vw, 2.8rem); margin-bottom: 3rem; }
    .visit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; max-width: 880px; margin: 0 auto; text-align: left; }
    .visit-list { list-style: none; padding: 0; margin: 0 0 2rem; }
    .visit-list li { padding: .85rem 0; border-bottom: 1px solid rgba(251,246,239,.15); display: flex; flex-direction: column; gap: .25rem; }
    .visit-list li:last-child { border-bottom: none; }
    .visit-list .lbl { font-size: .72rem; color: rgba(251,246,239,.55); letter-spacing: .12em; text-transform: uppercase; font-weight: 600; }
    .visit-list a { color: var(--gold-light); font-weight: 600; }
    .visit-list a:hover { color: #fff; opacity: 1; }
    .visit-hours h3 { font-family: 'Cormorant Garamond', serif; color: var(--cream); font-size: 1.6rem; margin-bottom: 1rem; }
    .hours-list { list-style: none; padding: 0; margin: 0; }
    .hours-list li { display: flex; justify-content: space-between; padding: .5rem 0; border-bottom: 1px solid rgba(251,246,239,.1); font-size: .96rem; }
    .hours-list li:last-child { border-bottom: none; }
    .hours-list .closed { color: rgba(251,246,239,.45); }
    .visit-ctas { display: flex; gap: .7rem; flex-wrap: wrap; }
    .btn.big { font-size: 1rem; padding: 1.1rem 2rem; }
    .visit .btn-primary { background: var(--gold); color: var(--ink); }
    .visit .btn-primary:hover { background: var(--gold-light); color: var(--ink); }
    .visit .btn-gold { background: var(--cream); color: var(--burgundy); }
    .visit .btn-gold:hover { background: #fff; color: var(--burgundy-dark); }

    .site-footer { background: #2a1a1d; color: rgba(251,246,239,.65); padding: 3rem 0 2.5rem; font-size: .9rem; }
    .footer-inner { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem 2rem; align-items: center; }
    .footer-brand { display: flex; align-items: center; }
    .footer-brand :global(svg) { height: 50px; width: auto; }
    .footer-meta { text-align: right; }
    .footer-meta a { color: var(--gold-light); }
    .footer-meta a:hover { color: var(--cream); opacity: 1; }
    .footer-meta .dot { color: rgba(251,246,239,.25); padding: 0 .35rem; }
    .footer-fineprint { grid-column: 1 / -1; text-align: center; padding-top: 1.5rem; border-top: 1px solid rgba(251,246,239,.08); font-size: .82rem; color: rgba(251,246,239,.4); }

    .mobile-bar { display: none; position: fixed; bottom: 0; left: 0; right: 0; padding: .65rem .75rem calc(.65rem + env(safe-area-inset-bottom, 0)); background: rgba(251,246,239,.98); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-top: 1px solid var(--line); gap: .55rem; z-index: 100; box-shadow: 0 -8px 30px rgba(122,31,43,.1); }
    .mobile-bar-btn { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .9rem 1rem; border-radius: 999px; font-weight: 600; font-size: .94rem; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
    .mobile-bar-btn.primary { background: var(--burgundy); color: var(--cream); }
    .mobile-bar-btn.primary:active { transform: scale(.97); }
    .mobile-bar-btn.gold { background: var(--gold); color: #fff; }
    .mobile-bar-btn.gold:active { transform: scale(.97); }
    .mobile-bar-btn svg { flex-shrink: 0; }

    .lightbox { position: fixed; inset: 0; background: rgba(20,8,12,.92); display: none; align-items: center; justify-content: center; z-index: 200; padding: 2rem; opacity: 0; transition: opacity .2s ease; }
    .lightbox.is-open { display: flex; opacity: 1; }
    .lightbox-figure { margin: 0; max-width: 90vw; max-height: 90vh; display: flex; flex-direction: column; align-items: center; gap: .8rem; }
    .lightbox img { max-width: 90vw; max-height: 78vh; border-radius: 12px; object-fit: contain; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
    .lightbox figcaption { color: var(--cream); font-family: 'Cormorant Garamond', serif; font-size: 1.15rem; font-style: italic; letter-spacing: .02em; }
    .lightbox-close, .lightbox-prev, .lightbox-next { position: absolute; background: rgba(251,246,239,.12); border: 1px solid rgba(251,246,239,.25); color: var(--cream); width: 48px; height: 48px; border-radius: 50%; font-size: 1.6rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .15s ease, transform .15s ease; font-family: inherit; line-height: 1; }
    .lightbox-close { top: 1.25rem; right: 1.25rem; }
    .lightbox-prev { left: 1.5rem; top: 50%; transform: translateY(-50%); }
    .lightbox-next { right: 1.5rem; top: 50%; transform: translateY(-50%); }
    .lightbox-close:hover, .lightbox-prev:hover, .lightbox-next:hover { background: rgba(251,246,239,.22); }
    .lightbox-prev:hover { transform: translateY(-50%) scale(1.08); }
    .lightbox-next:hover { transform: translateY(-50%) scale(1.08); }

    @media (max-width: 980px) {
      .social-inner { grid-template-columns: 1fr; gap: 2rem; }
      .services-columns { grid-template-columns: 1fr; }
      .stylists { grid-template-columns: 1fr; }
    }

    @media (max-width: 900px) {
      .nav { display: none; }
      .menu-toggle { display: inline-flex; }
      .mobile-menu { display: block; }
      .topbar-row { padding: .55rem 1rem; gap: .6rem; }
      .topbar-call { display: none; }
      .lang-switch { padding: .35rem .6rem; font-size: .72rem; }
      .brand :global(svg) { height: 56px; }
      .hero { padding: 3rem 0 4.5rem; }
      .hero-grid, .about-grid, .visit-grid, .founder-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .hero-photo { order: -1; max-width: 360px; margin: 0 auto; justify-self: center; }
      .hero-badge { bottom: .35rem; left: .35rem; padding: .7rem 1rem; }
      .hero h1 { font-size: clamp(2.2rem, 8vw, 3rem); }
      .hero-cta { flex-direction: column; gap: .7rem; }
      .hero-cta .btn { justify-content: center; width: 100%; }
      .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; padding: 1.5rem 0 0; }
      .hero-stats strong { font-size: 1.5rem; }
      .founder { padding: 3.5rem 0; }
      .founder-photo { max-width: 320px; margin: 0 auto; }
      .why, .services, .about, .work, .reviews, .social, .faq, .visit { padding: 4rem 0; }
      .section-head { margin-bottom: 2.5rem; }
      .about-photo { max-width: 360px; margin: 0 auto; }
      .signature-card { padding: 1.8rem 1.5rem; }
      .signature-card h3 { font-size: 1.35rem; }
      .services-cta { grid-template-columns: 1fr; }
      .visit-ctas { flex-direction: column; }
      .visit-ctas .btn { width: 100%; justify-content: center; }
      .footer-inner { grid-template-columns: 1fr; text-align: center; }
      .footer-brand { justify-content: center; }
      .footer-meta { text-align: center; }
      .mobile-bar { display: flex; }
      body { padding-bottom: 5.5rem; }
      .lightbox-prev, .lightbox-next { width: 40px; height: 40px; font-size: 1.4rem; }
      .lightbox-prev { left: .5rem; }
      .lightbox-next { right: .5rem; }
    }

    @media (max-width: 480px) {
      .hero-stats { grid-template-columns: 1fr 1fr; }
      .hero-photo { max-width: 300px; }
    }
  </style>

  <script is:inline>
    (() => {
      const topbar = document.querySelector('.topbar');
      const progressBar = document.querySelector('.topbar-progress span');
      if (!topbar) return;
      const onScroll = () => {
        topbar.classList.toggle('scrolled', window.scrollY > 30);
        if (progressBar) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          progressBar.style.transform = `scaleX(${ratio})`;
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();

    (() => {
      const toggle = document.querySelector('.menu-toggle');
      const menu = document.getElementById('mobile-menu');
      if (!toggle || !menu) return;
      const closeMenu = () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      };
      const openMenu = () => {
        toggle.setAttribute('aria-expanded', 'true');
        menu.hidden = false;
      };
      toggle.addEventListener('click', () => {
        if (toggle.getAttribute('aria-expanded') === 'true') closeMenu();
        else openMenu();
      });
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('click', (event) => {
        if (menu.hidden) return;
        const target = event.target;
        if (!(target instanceof Node)) return;
        if (menu.contains(target) || toggle.contains(target)) return;
        closeMenu();
      });
      window.addEventListener('resize', () => {
        if (window.innerWidth > 900) closeMenu();
      });
    })();

    (() => {
      if (!('IntersectionObserver' in window)) return;
      const links = Array.from(document.querySelectorAll('[data-nav]'));
      if (!links.length) return;
      const map = new Map();
      links.forEach((link) => {
        const href = link.getAttribute('href') || '';
        if (!href.startsWith('#')) return;
        const id = href.slice(1);
        const section = document.getElementById(id);
        if (!section) return;
        const existing = map.get(section) || [];
        existing.push(link);
        map.set(section, existing);
      });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => link.classList.remove('is-active'));
          const activeLinks = map.get(entry.target) || [];
          activeLinks.forEach((link) => link.classList.add('is-active'));
        });
      }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });
      map.forEach((_links, section) => io.observe(section));
    })();

    (() => {
      if (!('IntersectionObserver' in window)) return;
      const targets = document.querySelectorAll('.section-head, .why-card, .signature-card, .service-group, .work-card, .review-card, .social-panel, .social-note, .faq-item');
      if (!targets.length) return;
      const io = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
      targets.forEach((target, index) => {
        target.classList.add('reveal-ready');
        target.setAttribute('style', `${target.getAttribute('style') || ''};transition-delay:${Math.min(index * 28, 220)}ms`);
        io.observe(target);
      });
    })();

    (() => {
      const btns = document.querySelectorAll('.work .filter-btn');
      const items = document.querySelectorAll('#gallery-grid .work-card');
      if (!btns.length || !items.length) return;
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          btns.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');
          items.forEach((it) => {
            const cat = it.getAttribute('data-cat');
            if (filter === 'all' || cat === filter) it.classList.remove('is-hidden');
            else it.classList.add('is-hidden');
          });
        });
      });
    })();

    (() => {
      const btns = document.querySelectorAll('.reviews .filter-btn');
      const items = document.querySelectorAll('#review-grid .review-card');
      if (!btns.length || !items.length) return;
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          btns.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');
          items.forEach((it) => {
            const cat = it.getAttribute('data-cat');
            if (filter === 'all' || cat === filter) it.classList.remove('is-hidden');
            else it.classList.add('is-hidden');
          });
        });
      });
    })();

    (() => {
      const lb = document.getElementById('lightbox');
      const lbImg = document.getElementById('lightbox-img');
      const lbCap = document.getElementById('lightbox-cap');
      const closeBtn = lb && lb.querySelector('.lightbox-close');
      const prevBtn = lb && lb.querySelector('.lightbox-prev');
      const nextBtn = lb && lb.querySelector('.lightbox-next');
      const cards = Array.from(document.querySelectorAll('#gallery-grid .work-card'));
      if (!lb || !lbImg || !lbCap || !cards.length) return;
      let idx = 0;

      function visibleCards() { return cards.filter((c) => !c.classList.contains('is-hidden')); }
      function open(i) {
        const list = visibleCards();
        if (!list.length) return;
        idx = ((i % list.length) + list.length) % list.length;
        const card = list[idx];
        lbImg.src = card.getAttribute('data-src') || '';
        lbImg.alt = card.getAttribute('data-label') || '';
        lbCap.textContent = card.getAttribute('data-label') || '';
        lb.classList.add('is-open');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function close() {
        lb.classList.remove('is-open');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      function step(d) { open(idx + d); }

      cards.forEach((card) => {
        card.addEventListener('click', () => {
          const list = visibleCards();
          const pos = list.indexOf(card);
          open(pos >= 0 ? pos : 0);
        });
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            card.click();
          }
        });
      });
      closeBtn && closeBtn.addEventListener('click', close);
      prevBtn && prevBtn.addEventListener('click', () => step(-1));
      nextBtn && nextBtn.addEventListener('click', () => step(1));
      lb.addEventListener('click', (e) => {
        if (e.target === lb) close();
      });
      document.addEventListener('keydown', (e) => {
        if (!lb.classList.contains('is-open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
      });
    })();
  </script>
