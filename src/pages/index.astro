---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const phone = '(978) 208-7877';
const phoneTel = '+19782087877';
const address = '264 S Broadway, Lawrence, MA 01843';
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=264+S+Broadway%2C+Lawrence%2C+MA+01843';
const reviewsUrl = 'https://www.google.com/search?q=Mia+Beauty+Boutique+Lawrence+MA';
const instagramUrl = 'https://www.instagram.com/miabeautyboutique264/';
const facebookUrl = 'https://www.facebook.com/p/Mia-Beauty-Boutique-100058155380527/';
const yelpUrl = 'https://www.yelp.com/biz/mia-beauty-boutique-lawrence-2';

const BASE = import.meta.env.BASE_URL;
const ownerImg = (name: string) => `${BASE}images/owner/2026-05-27/${name}`;

const focusServices = [
  { title: 'Secado dominicano', icon: '✦', body: 'Uno de nuestros servicios más pedidos, con brillo, movimiento y una duración que muchas clientas sienten toda la semana.' },
  { title: 'Colorimetría y Mechas', icon: '✦', body: 'Balayage, highlights, color completo y corrección, siempre pensando primero en la salud del cabello.' },
  { title: 'Laciados y Queratina', icon: '✦', body: 'Servicios de alisado y control de frizz elegidos según textura, largo y mantenimiento real.' },
  { title: 'Extensiones y Peinados', icon: '✦', body: 'Postura de extensiones, peinados pulidos y acabados que se ven bonitos tanto en persona como en fotos.' },
  { title: 'Novias y Eventos', icon: '✦', body: 'Peinado y maquillaje con prueba previa, buena organización y resultados que aguantan todo el día.' },
];

const serviceGroups = [
  {
    title: 'Cabello',
    intro: 'Los servicios que más nos piden en el salón.',
    items: [
      'Secado dominicano',
      'Colorimetría',
      'Mechas y balayage',
      'Todo tipo de cortes',
      'Postura de extensiones',
      'Todo tipo de alisado',
      'Todo tipo de peinado',
      'Tratamientos y reparación',
    ],
  },
  {
    title: 'Belleza',
    intro: 'Detalles para completar tu cita sin salir del mismo lugar.',
    items: [
      'Maquillaje profesional',
      'Novias y eventos',
      'Depilación',
      'Tintados',
      'Pestañas',
    ],
  },
  {
    title: 'Uñas',
    intro: 'Servicios de uñas que también queremos destacar.',
    items: [
      'Polygel',
      'Rubber base',
      'Resina',
      'Acrílico',
      'Gel y diseños',
      'Todo tipo de pedicura',
    ],
  },
];

const whyMia = [
  { title: 'Resultados que aguantan', body: 'El secado, el peinado y el acabado se trabajan para que sigan viéndose pulidos después de salir del salón.' },
  { title: 'Orientación honesta', body: 'Si algo necesita consulta previa, te lo decimos. Si un servicio te conviene más que otro, también.' },
  { title: 'Belleza completa en una visita', body: 'Cabello, uñas, pestañas y depilación, todo con una misma dirección visual y una misma atención.' },
  { title: 'Confianza de la comunidad', body: 'Mujeres de Lawrence y ciudades cercanas vuelven por la mezcla de buen trato, rapidez y resultados bonitos.' },
];

const salonPoints = [
  { name: 'Cabello', role: 'secado · color · alisados', body: 'Desde secados del día a día hasta cambios de color y extensiones, trabajamos según el estado real de tu cabello.' },
  { name: 'Belleza', role: 'uñas · pestañas · depilación', body: 'También resolvemos los detalles que completan el look, sin que la cita se sienta apurada ni improvisada.' },
  { name: 'Equipo bilingüe', role: 'español · inglés', body: 'La consulta es clara, directa y cómoda, tanto para clientas de siempre como para primeras visitas.' },
];

const reviews = [
  { name: 'Yesenia M.', source: 'Google', body: 'Todas las muchachas son tan dulces. Y trabajan en equipo, siempre salgo feliz. Mi secado me dura toda la semana.', cat: 'blower' },
  { name: 'Joselyn T.', source: 'Google', body: 'Sin cita previa y siempre me atienden rápido. Mi secado me dura toda la semana. Las recomiendo a todas mis amigas.', cat: 'blower' },
  { name: 'Mariela P.', source: 'Yelp', body: 'Llevo años yendo. Conocen mi cabello como nadie. No voy a otro salón.', cat: 'blower' },
  { name: 'Carmen R.', source: 'Google', body: 'Me hicieron sentir como una reina el día de mi boda. El maquillaje duró todo el día y todas las fotos quedaron preciosas.', cat: 'novias' },
  { name: 'Linette V.', source: 'Google', body: 'Me hicieron las extensiones para mi quinceañera. Quedaron naturales, suaves, y mi mamá lloró de la emoción.', cat: 'novias' },
  { name: 'Andrea S.', source: 'Facebook', body: 'El mejor color que me han hecho en mi vida. Saben cuidar el cabello, no se quema, no se daña.', cat: 'color' },
];

const reviewFilters = [
  { id: 'todo', label: 'Todas' },
  { id: 'blower', label: 'Secados y cuidado' },
  { id: 'novias', label: 'Novias y eventos' },
  { id: 'color', label: 'Color' },
];

const galleryItems = [
  { src: 'gallery-blower-curls.jpg', cat: 'blower', label: 'Secado dominicano' },
  { src: 'gallery-color-balayage.jpg', cat: 'color', label: 'Balayage Caramelo' },
  { src: 'gallery-blower-golden.jpg', cat: 'blower', label: 'Secado dominicano' },
  { src: 'gallery-color-red.jpg', cat: 'color', label: 'Color Rojo' },
  { src: 'gallery-extensions-detail.jpg', cat: 'extensiones', label: 'Extensiones' },
  { src: 'gallery-cut-pixie.jpg', cat: 'cortes', label: 'Corte Pixie' },
  { src: 'gallery-color-red-black.jpg', cat: 'color', label: 'Mechas Rojas' },
  { src: 'gallery-cut-platinum.jpg', cat: 'cortes', label: 'Corte Platinum' },
];

const galleryFilters = [
  { id: 'todo', label: 'Todo' },
  { id: 'blower', label: 'Secados' },
  { id: 'color', label: 'Color' },
  { id: 'extensiones', label: 'Extensiones' },
  { id: 'cortes', label: 'Cortes' },
];

const socialHighlights = [
  'Transformaciones nuevas cada semana',
  'Ideas para novias, color y secados',
  'Uñas, pestañas y detalles del salón',
];

const socialNotes = [
  { title: 'Qué vas a ver', body: 'Resultados reales, videos cortos y trabajos recién salidos del salón.' },
  { title: 'Para qué sirve', body: 'Si vienes por color, novias, secado o uñas, ahí subimos lo más reciente.' },
  { title: 'Cómo escribirnos', body: 'Guarda la foto que te guste y mándala por Instagram o llámanos para hablarla.' },
];

const faqs = [
  { q: '¿Tengo que hacer cita?', a: 'No, te atendemos sin cita por orden de llegada. Para servicios largos, como novias, color completo o extensiones, recomendamos llamar antes para asegurar tu hora.' },
  { q: '¿Por qué no publican precios exactos?', a: 'Porque el costo cambia según largo, densidad, diseño, retoque o transformación completa. Preferimos orientarte bien cuando sabemos qué servicio quieres y cómo está tu cabello o tus uñas.' },
  { q: '¿Necesito consulta antes de una boda o color completo?', a: 'Sí, vale la pena llamarnos antes para hablarlo bien. Para novias hacemos prueba de maquillaje y peinado. Para color completo o corrección, preferimos ver el cabello o conversar primero.' },
  { q: '¿Piden depósito para novias?', a: 'Para asegurar tu fecha pedimos un depósito pequeño que luego se descuenta del total. Cada boda es distinta, así que llámanos y te orientamos.' },
  { q: '¿Cuáles son los mejores días para venir?', a: 'Martes a jueves son nuestros días más tranquilos. Viernes y sábados son los más llenos. Si vienes temprano, mejor.' },
  { q: '¿Trabajan con todo tipo de cabello?', a: 'Sí. Somos especialistas en cabello dominicano, rizos, ondas, texturas mixtas, cabello fino, grueso o teñido. Trabajamos cada tipo con la técnica correcta.' },
  { q: '¿También hacen uñas?', a: 'Sí. Ofrecemos polygel, rubber base, resina, acrílico, gel, diseños y todo tipo de pedicura. Puedes hacer cabello y uñas en la misma visita.' },
  { q: '¿Cuánto dura el secado dominicano?', a: 'Con cuidado básico, como gorro de noche y evitando mojarlo, muchas clientas lo sienten bonito toda la semana, y algunas llegan a 10 días.' },
  { q: '¿Hacen novias y eventos grandes?', a: 'Sí. Para novias, separa tu fecha con tiempo. Ofrecemos prueba de maquillaje y peinado, y te ayudamos a organizar el día.' },
  { q: '¿Qué formas de pago aceptan?', a: 'Efectivo y tarjeta de crédito, Visa, Mastercard y Amex. Si tienes una duda puntual, llámanos antes de venir.' },
  { q: '¿Hay parqueo?', a: 'Sí, hay parqueo gratis en la calle y lotes cercanos en S Broadway. Estamos en una zona fácil de encontrar.' },
  { q: '¿Hablan inglés?', a: 'Sí. Todo el equipo atiende en español e inglés. Recibimos clientas de Lawrence, Methuen, Andover, Haverhill, Lowell y Salem, NH.' },
];
---

<Base lang="es" pathEs="/" pathEn="/en/">
  <header class="topbar">
    <div class="container topbar-row">
      <a class="brand" href="#top" aria-label="Mía Beauty Boutique">
        <Logo size="md" />
      </a>
      <nav class="nav" aria-label="Principal">
        <a href="#marilyn" data-nav>Historia</a>
        <a href="#por-que" data-nav>Por Qué Mía</a>
        <a href="#servicios" data-nav>Servicios</a>
        <a href="#galeria" data-nav>Galería</a>
        <a href="#resenas" data-nav>Reseñas</a>
        <a href="#faq" data-nav>FAQ</a>
        <a href="#visitar" data-nav>Visitar</a>
      </nav>
      <div class="topbar-right">
        <a class="lang-switch" href={`${BASE}en/`} hreflang="en" aria-label="View in English">EN</a>
        <a class="topbar-call" href={`tel:${phoneTel}`}>{phone}</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
          <span class="menu-toggle-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span>Menú</span>
        </button>
      </div>
    </div>
    <div class="topbar-progress" aria-hidden="true"><span></span></div>
    <div class="mobile-menu" id="mobile-menu" hidden>
      <div class="mobile-menu-inner">
        <a href="#marilyn" data-nav>Historia</a>
        <a href="#por-que" data-nav>Por Qué Mía</a>
        <a href="#servicios" data-nav>Servicios</a>
        <a href="#galeria" data-nav>Galería</a>
        <a href="#resenas" data-nav>Reseñas</a>
        <a href="#faq" data-nav>FAQ</a>
        <a href="#visitar" data-nav>Visitar</a>
        <a class="mobile-menu-call" href={`tel:${phoneTel}`}>Llamar al salón</a>
      </div>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Lawrence, MA · más de 30 años de experiencia</span>
        <h1>Brillo, movimiento y belleza bien hecha.</h1>
        <p class="hero-lede">
          Mía Beauty Boutique es el salón para clientas que quieren secado dominicano, color, uñas y servicios de belleza con un acabado pulido, una atención cálida y una cita que se sienta bien llevada de principio a fin.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Llamar al salón</a>
          <a class="btn btn-gold" href={directionsUrl} target="_blank" rel="noopener">Cómo llegar</a>
          <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
        </div>
        <ul class="hero-stats">
          <li><strong>30+ años</strong><span>atendiendo en Lawrence</span></li>
          <li><strong>Sin cita</strong><span>para visitas del día a día</span></li>
          <li><strong>Bilingüe</strong><span>español · inglés</span></li>
          <li><strong>Consulta previa</strong><span>novias · color · extensiones</span></li>
        </ul>
      </div>
      <div class="hero-photo">
        <img src={ownerImg('gallery-blower-curls.jpg')} alt="Trabajo destacado de secado dominicano en Mía Beauty Boutique" loading="eager" />
        <div class="hero-badge hero-badge--phrase">
          <span>Cabello · uñas · belleza</span>
        </div>
      </div>
    </div>
  </section>

  <section class="founder" id="marilyn">
    <div class="container founder-grid">
      <div class="founder-photo">
        <img src={ownerImg('founder-placeholder.jpg')} alt="Trabajo de color y acabado pulido en Mía Beauty Boutique" loading="lazy" />
      </div>
      <div class="founder-copy">
        <span class="kicker">La visión de Marilyn</span>
        <h2>Un salón creado para que salgas viéndote pulida, no solo arreglada.</h2>
        <p>
          Marilyn levantó Mía Beauty Boutique con una idea sencilla: combinar técnica, trato cercano y resultados que de verdad se mantengan bonitos después de la cita.
        </p>
        <p>
          El salón lleva el nombre de su hija, Mía, y esa mezcla de cariño, disciplina y orgullo por el trabajo bien hecho sigue marcando cómo atienden hoy.
        </p>
        <span class="founder-sig">Marilyn · fundadora</span>
      </div>
    </div>
  </section>

  <section class="why" id="por-que">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Por qué Mía</span>
        <h2>Lo que la clienta siente distinto cuando entra aquí.</h2>
        <p class="section-sub">No buscamos sonar como cualquier salón. Queremos que la página se sienta como la cita: cuidada, clara y enfocada en resultados.</p>
      </div>
      <div class="why-grid">
        {whyMia.map((w, i) => (
          <article class="why-card" style={`--i: ${i}`}>
            <div class="why-num">0{i + 1}</div>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="services" id="servicios">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Servicios</span>
        <h2>Los servicios más pedidos, sin una lista confusa de precios.</h2>
        <p class="section-sub">Quitamos los precios del sitio porque el costo final depende del largo, la densidad, el diseño y el tiempo real de trabajo. Si quieres cotizar bien, llámanos.</p>
      </div>

      <div class="signature-grid">
        {focusServices.map((s, i) => (
          <article class="signature-card" style={`--i: ${i}`}>
            <span class="service-mark">{s.icon}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>

      <div class="services-columns">
        {serviceGroups.map((group, i) => (
          <article class="service-group" style={`--i: ${i}`}>
            <h3>{group.title}</h3>
            <p>{group.intro}</p>
            <ul class="service-tag-list">
              {group.items.map((item) => (
                <li class="service-tag">{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="services-cta" id="consulta">
        <div class="services-cta-card walk-in">
          <h4>¿Visita del día?</h4>
          <p>Te atendemos sin cita, por orden de llegada. Llámanos si quieres confirmar cómo va la espera.</p>
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Llamar al {phone}</a>
        </div>
        <div class="services-cta-card premium">
          <h4>¿Boda, color completo o transformación?</h4>
          <p>Llámamos antes para hablar lo que quieres y llegar al día con el plan claro, sin improvisar.</p>
          <a class="btn btn-gold" href={`tel:${phoneTel}`}>Llamar para consulta</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about" id="sobre">
    <div class="container about-grid">
      <div class="about-photo">
        <img src={ownerImg('about-salon.jpg')} alt="Trabajo de color y secado en Mía Beauty Boutique" loading="lazy" />
      </div>
      <div class="about-copy">
        <span class="kicker">Tu cita</span>
        <h2>Pensamos cada servicio según tu cabello, tu tiempo y el resultado que buscas.</h2>
        <p>
          Aquí no usamos una lista rígida de precios porque un secado, un color o una pedicura no cuestan lo mismo para todas. El largo, la densidad, el diseño y el tiempo real de trabajo importan.
        </p>
        <p>
          Por eso la web te enseña claramente lo que hacemos, y la cotización final la damos cuando sabemos bien qué necesitas.
        </p>
        <div class="stylists">
          {salonPoints.map((s) => (
            <div class="stylist">
              <h4>{s.name}</h4>
              <span class="stylist-role">{s.role}</span>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <p class="about-pull">
          Si vienes por color, novias, extensiones o un cambio completo, llámanos antes y lo preparamos bien.
        </p>
      </div>
    </div>
  </section>

  <section class="work" id="galeria">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Galería</span>
        <h2>Trabajo real del salón.</h2>
        <p class="section-sub">Filtra por categoría y toca cualquier foto para verla más grande.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filtrar galería">
        {galleryFilters.map((f, i) => (
          <button
            class={`filter-btn${i === 0 ? ' is-active' : ''}`}
            data-filter={f.id}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
      <div class="work-grid" id="gallery-grid">
        {galleryItems.map((w, i) => {
          const path = ownerImg(w.src);
          return (
            <figure
              class="work-card"
              data-cat={w.cat}
              style={`--i: ${i}`}
              data-src={path}
              data-label={w.label}
              tabindex="0"
              role="button"
              aria-label={`Ver ${w.label} en grande`}
            >
              <img src={path} alt={w.label} loading="lazy" />
              <figcaption>{w.label}</figcaption>
            </figure>
          );
        })}
      </div>
      <p class="gallery-note">Síguenos en <a href={instagramUrl} target="_blank" rel="noopener">Instagram</a> para ver trabajos nuevos cada semana.</p>
    </div>
  </section>

  <section class="reviews" id="resenas">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Reseñas</span>
        <h2>Lo que dicen las clientas cuando salen contentas.</h2>
        <p class="section-sub">Reseñas reales de Google, Yelp y Facebook, filtradas por lo que más buscan.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filtrar reseñas">
        {reviewFilters.map((f, i) => (
          <button
            class={`filter-btn${i === 0 ? ' is-active' : ''}`}
            data-filter={f.id}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
      <div class="review-grid" id="review-grid">
        {reviews.map((r, i) => (
          <article class="review-card" data-cat={r.cat} style={`--i: ${i}`}>
            <div class="stars" aria-label="5 estrellas">★★★★★</div>
            <blockquote>{r.body}</blockquote>
            <cite>{r.name} <span class="review-source">· {r.source}</span></cite>
          </article>
        ))}
      </div>
      <div class="reviews-cta">
        <a class="btn btn-primary" href={reviewsUrl} target="_blank" rel="noopener">Leer más reseñas</a>
        <a class="btn btn-ghost" href={reviewsUrl} target="_blank" rel="noopener">Ver reseñas en Google</a>
      </div>
    </div>
  </section>

  <section class="social" id="social">
    <div class="container social-inner">
      <div class="social-copy">
        <span class="kicker">Instagram</span>
        <h2>Un feed que se sienta tan alineado como el salón.</h2>
        <p>Ahí vive lo más reciente: color, blowouts, novias, uñas y detalles del día a día. Lo usamos como portafolio vivo, no como relleno.</p>
        <div class="social-cta">
          <a class="btn btn-primary" href={instagramUrl} target="_blank" rel="noopener">Seguir en Instagram</a>
          <a class="btn btn-ghost" href={facebookUrl} target="_blank" rel="noopener">Facebook</a>
        </div>
        <span class="ig-handle">@miabeautyboutique264</span>
      </div>
      <div class="social-panel">
        <div class="social-chip-list">
          {socialHighlights.map((item) => (
            <span class="social-chip">{item}</span>
          ))}
        </div>
        <div class="social-note-list">
          {socialNotes.map((note, i) => (
            <article class="social-note" style={`--i: ${i}`}>
              <h3>{note.title}</h3>
              <p>{note.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Preguntas</span>
        <h2>Todo lo que quieres saber antes de venir.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" style={`--i: ${i}`}>
            <summary>
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="worth-drive">
    <div class="container worth-inner">
      <span class="kicker">Vienen de toda el área</span>
      <h3>Clientas de Lawrence, Methuen, Andover, Haverhill, Lowell y Salem, NH.</h3>
      <p>Vale el camino, vale la técnica y siempre vale el cuidado.</p>
    </div>
  </section>

  <section class="visit" id="visitar">
    <div class="container visit-inner">
      <span class="kicker light">Visítanos</span>
      <h2>Te esperamos en Lawrence.</h2>
      <div class="visit-grid">
        <div class="visit-info">
          <ul class="visit-list">
            <li><span class="lbl">Dirección</span><span>{address}</span></li>
            <li><span class="lbl">Teléfono</span><a href={`tel:${phoneTel}`}>{phone}</a></li>
            <li><span class="lbl">Sin cita previa</span><span>Te atendemos por orden de llegada</span></li>
            <li><span class="lbl">Parqueo</span><span>Gratis en la calle y lotes cercanos</span></li>
            <li><span class="lbl">Pago</span><span>Efectivo y tarjeta, Visa · MC · Amex</span></li>
            <li><span class="lbl">Mejor día</span><span>Martes a jueves, menos espera</span></li>
