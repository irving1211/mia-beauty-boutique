---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const phone = '(978) 208-7877';
const phoneTel = '+19782087877';
const address = '264 S Broadway, Lawrence, MA 01843';
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=264+S+Broadway%2C+Lawrence%2C+MA+01843';
const mapsUrl = 'https://www.google.com/maps/place/264+S+Broadway,+Lawrence,+MA+01843';
const reviewsUrl = 'https://www.google.com/search?q=Mia+Beauty+Boutique+Lawrence+MA';
// TODO: Real Google Place ID still needed for the "leave a review" link. Until confirmed,
// the "Dejar reseña" button is routed to reviewsUrl (Google search) instead of a broken placeholder.
const writeReviewUrl = 'https://search.google.com/local/writereview?placeid=ChIJ_____MiaBeautyBoutique'; // placeholder — do NOT link in UI until real Place ID confirmed
const instagramUrl = 'https://www.instagram.com/miabeautyboutique264/';
const facebookUrl = 'https://www.facebook.com/p/Mia-Beauty-Boutique-100058155380527/';
const yelpUrl = 'https://www.yelp.com/biz/mia-beauty-boutique-lawrence-2';

const BASE = import.meta.env.BASE_URL;
const img = (name: string) => `${BASE}images/work/${name}`;
const ownerImg = (name: string) => `${BASE}images/owner/2026-05-27/${name}`;

const services = [
  // Signature — top-ticket services the salon is known for
  { title: 'Blower Dominicano', tier: 'signature', icon: '✦', body: 'Nuestra especialidad. El blower que nos hizo conocidas — suave, con cuerpo, brillante, y que aguanta toda la semana.', price: 'Desde $45' },
  { title: 'Color y Mechas', tier: 'signature', icon: '✦', body: 'Color, balayage, mechas, corrección. Trabajamos con Pravana y marcas profesionales. Cuidamos el cabello primero.', price: 'Llama para consulta' },
  { title: 'Novias y Eventos', tier: 'signature', icon: '✦', body: 'Maquillaje y peinado de novia, quinceañeras, eventos. Hacemos prueba antes del día. Separa tu fecha con tiempo.', price: 'Cita previa' },
  { title: 'Extensiones y Transformaciones', tier: 'signature', icon: '✦', body: 'Extensiones brasileras y de cabello natural, queratina, alaciados, cambios completos. Conversemos antes de la cita.', price: 'Consulta requerida' },

  // Secondary — also offered
  { title: 'Cortes', tier: 'secondary', icon: '✦', body: 'Cortes clásicos, modernos, capas, flequillo.', price: 'Desde $30' },
  { title: 'Maquillaje Profesional', tier: 'secondary', icon: '✦', body: 'Para eventos, sesiones de fotos, o un día especial.', price: 'Desde $65' },
  { title: 'Tratamientos', tier: 'secondary', icon: '✦', body: 'Hidratación profunda, queratina, brillo y reparación.', price: 'Desde $40' },
  { title: 'Depilación con Hilo', tier: 'secondary', icon: '✦', body: 'Cejas, bigote, rostro. Técnica precisa para piel sensible.', price: 'Desde $12' },
  { title: 'Manicura', tier: 'secondary', icon: '✦', body: 'Manicura clásica, gel, diseños de uñas.', price: 'Desde $20' },
  { title: 'Pedicura', tier: 'secondary', icon: '✦', body: 'Pedicura clásica y spa. Pies suaves, uñas perfectas.', price: 'Desde $30' },
  { title: 'Uñas Acrílicas y Gel', tier: 'secondary', icon: '✦', body: 'Acrílicas, gel, dip powder, arte de uñas.', price: 'Desde $35' },
];

const signatureServices = services.filter((s) => s.tier === 'signature');
const secondaryServices = services.filter((s) => s.tier === 'secondary');

const whyMia = [
  { title: 'Cabello dominicano con criterio', body: 'Trabajamos rizos, ondas, texturas mixtas, color y procesos con experiencia real. Sabemos cuándo dar brillo, cuándo cuidar, y cómo lograr un resultado bonito sin maltratar el cabello.' },
  { title: 'Sin cita, pero bien atendida', body: 'Aquí puedes llegar y te recibimos por orden de llegada. Hacemos que la visita se sienta organizada, cómoda y con atención de verdad.' },
  { title: 'Español natural, trato cercano', body: 'Te hablamos claro, te escuchamos bien y te orientamos según lo que te favorece. Queremos que te sientas cómoda y segura desde que entras.' },
  { title: 'Resultados que lucen y duran', body: 'Blowers con movimiento, color bien trabajado y cambios que se ven bonitos en persona, no solo en foto.' },
];

const stylists = [
  { name: 'Marilyn', role: 'Fundadora · Estilista principal', body: 'Más de 30 años de experiencia en blower dominicano, color y cuidado del cabello. Su enfoque siempre ha sido el mismo: trabajar con detalle y hacer que cada clienta salga viéndose hermosa.' },
  { name: 'El equipo', role: 'Estilistas bilingües', body: 'Color, cortes, extensiones, novias, maquillaje y atención bilingüe. Trabajamos en equipo para que tu visita se sienta ágil, organizada y bien cuidada.' },
];

const reviews = [
  { name: 'Yesenia M.', source: 'Google', body: 'Todas las muchachas son tan dulces. Y trabajan en equipo — siempre salgo feliz. Mi blowout dura toda la semana.', cat: 'blower' },
  { name: 'Joselyn T.', source: 'Google', body: 'Sin cita previa y siempre me atienden rápido. Mi blowout dura toda la semana. Las recomiendo a todas mis amigas.', cat: 'blower' },
  { name: 'Mariela P.', source: 'Yelp', body: 'Llevo años yendo. Conocen mi cabello como nadie. No voy a otro salón.', cat: 'blower' },
  { name: 'Carmen R.', source: 'Google', body: 'Me hicieron sentir como una reina el día de mi boda. El maquillaje duró todo el día y todas las fotos quedaron preciosas.', cat: 'novias' },
  { name: 'Linette V.', source: 'Google', body: 'Me hicieron las extensiones para mi quinceañera. Quedaron naturales, suaves, y mi mamá lloró de la emoción.', cat: 'novias' },
  { name: 'Andrea S.', source: 'Facebook', body: 'El mejor color que me han hecho en mi vida. Saben cuidar el cabello — no se quema, no se daña. Pravana de verdad.', cat: 'color' },
];

const reviewFilters = [
  { id: 'todo', label: 'Todas' },
  { id: 'blower', label: 'Blower y cuidado' },
  { id: 'novias', label: 'Novias y eventos' },
  { id: 'color', label: 'Color' },
];

const galleryItems = [
  { src: 'gallery-blower-curls.jpg', cat: 'blower', label: 'Blower Dominicano' },
  { src: 'gallery-color-balayage.jpg', cat: 'color', label: 'Balayage Caramelo' },
  { src: 'mia-3.jpg', cat: 'novias', label: 'Novias', legacy: true },
  { src: 'gallery-blower-golden.jpg', cat: 'blower', label: 'Blower Dominicano' },
  { src: 'gallery-color-red.jpg', cat: 'color', label: 'Color Rojo' },
  { src: 'gallery-extensions-detail.jpg', cat: 'extensiones', label: 'Extensiones' },
  { src: 'gallery-cut-pixie.jpg', cat: 'cortes', label: 'Corte Pixie' },
  { src: 'gallery-color-red-black.jpg', cat: 'color', label: 'Mechas Rojas' },
];

const galleryFilters = [
  { id: 'todo', label: 'Todo' },
  { id: 'blower', label: 'Blower' },
  { id: 'color', label: 'Color' },
  { id: 'novias', label: 'Novias' },
  { id: 'extensiones', label: 'Extensiones' },
  { id: 'cortes', label: 'Cortes' },
];

const faqs = [
  { q: '¿Tengo que hacer cita?', a: 'No, te atendemos sin cita por orden de llegada. Para servicios largos (novias, color completo, extensiones) recomendamos llamar antes para asegurar tu hora.' },
  { q: '¿Necesito consulta antes de una boda o color completo?', a: 'Recomendamos llamar antes para hablar — así llegamos al día listas. Para novias hacemos prueba de maquillaje y peinado antes del evento. Para color completo o corrección, conversamos por teléfono o pasas al salón para que veamos el cabello.' },
  { q: '¿Piden depósito para novias?', a: 'Para asegurar tu fecha pedimos un depósito pequeño que se descuenta del total el día del evento. Llámanos para los detalles — cada boda es distinta.' },
  { q: '¿Cuáles son los mejores días para venir?', a: 'Martes a jueves son nuestros días más tranquilos. Viernes y sábados son los más llenos — te atendemos igual, pero la espera puede ser más larga. Si vienes temprano, mejor.' },
  { q: '¿Trabajan con todo tipo de cabello?', a: 'Sí. Somos especialistas en cabello dominicano — rizos, ondas, texturas mixtas, cabello fino, grueso, teñido, todo. Trabajamos cada tipo con la técnica correcta.' },
  { q: '¿También hacen uñas?', a: 'Sí. Ofrecemos manicura, pedicura, uñas de gel, acrílicas, dip powder y arte de uñas. Puedes hacer cabello y uñas en la misma visita — perfecto para novias, eventos, o cuando quieres consentirte completa.' },
  { q: '¿Cuánto dura el blowout dominicano?', a: 'Con cuidado básico (gorro de noche, no mojarlo) un blowout dominicano nuestro te dura toda la semana — muchas clientas llegan a 10 días.' },
  { q: '¿Hacen novias y eventos grandes?', a: 'Sí. Para novias separa tu fecha con tiempo (idealmente 4-8 semanas antes). Ofrecemos prueba de maquillaje y peinado. Llama para hablar de tu día.' },
  { q: '¿Qué formas de pago aceptan?', a: 'Efectivo y tarjeta de crédito (Visa, Mastercard, Amex). Si tienes alguna duda, llámanos antes de venir.' },
  { q: '¿Hay parqueo?', a: 'Sí, parqueo gratis en la calle y en lotes cercanos en S Broadway. Plaza fácil de encontrar — estamos en el corazón de Lawrence.' },
  { q: '¿Hablan inglés?', a: 'Sí. Todo el equipo es bilingüe — español e inglés. Atendemos a clientas de Lawrence, Methuen, Andover, Haverhill, Lowell, y Salem NH.' },
];
---

<Base lang="es" pathEs="/" pathEn="/en/">
  <header class="topbar">
    <div class="container topbar-row">
      <a class="brand" href="#top" aria-label="Mía Beauty Boutique">
        <Logo size="md" />
      </a>
      <nav class="nav" aria-label="Principal">
        <a href="#marilyn" data-nav>Marilyn</a>
        <a href="#por-que" data-nav>Por Qué Mía</a>
        <a href="#servicios" data-nav>Servicios</a>
        <a href="#galeria" data-nav>Galería</a>
        <a href="#resenas" data-nav>Reseñas</a>
        <a href="#faq" data-nav>FAQ</a>
        <a href="#visitar" data-nav>Visitar</a>
      </nav>
      <div class="topbar-right">
        <a class="lang-switch" href={`${BASE}en/`} hreflang="en" aria-label="View in English">EN</a>
        <a class="topbar-call" href={`tel:${phoneTel}`}>{phone}</a>
      </div>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Lawrence, MA · Belleza con experiencia y mucho cuidado</span>
        <h1>Donde el cabello dominicano <em>brilla</em>.</h1>
        <p class="hero-lede">
          Mía Beauty Boutique es un salón en Lawrence, MA donde trabajamos el cabello con técnica, cuidado y buen gusto. Aquí vienes por un blower hermoso, un color bien hecho, una transformación, o simplemente por sentirte bien atendida de principio a fin.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Llamar al salón</a>
          <a class="btn btn-gold" href={directionsUrl} target="_blank" rel="noopener">Cómo llegar</a>
          <a class="btn btn-ghost" href="#consulta">¿Boda, color, transformación?</a>
        </div>
        <ul class="hero-stats">
          <li><strong>30+</strong><span>años de experiencia</span></li>
          <li><strong>Sin cita</strong><span>te atendemos por orden</span></li>
          <li><strong>Bilingüe</strong><span>español · english</span></li>
          <li><strong>Especialidad</strong><span>blower · color · cambios</span></li>
        </ul>
      </div>
      <div class="hero-photo">
        <img src={img('mia-1.jpg')} alt="Trabajo destacado de Mía Beauty Boutique" loading="eager" />
        <div class="hero-badge">
          <strong>30+</strong>
          <span>años en Lawrence</span>
        </div>
      </div>
    </div>
  </section>

  <section class="founder" id="marilyn">
    <div class="container founder-grid">
      <div class="founder-photo">
        {/* TODO: Replace src with a real portrait of Marilyn (fundadora) when provided. Currently using identity-neutral salon work shot from owner media 2026-05-27 (raw: "WhatsApp Image 2026-05-27 at 21.21.21 (1).jpeg"). No clearly captioned Marilyn portrait was included in that batch. Update both src AND alt once a real founder portrait arrives. */}
        <img src={ownerImg('founder-placeholder.jpg')} alt="Trabajo del salón Mía Beauty Boutique en Lawrence, MA — cabello largo con balayage" loading="lazy" />
      </div>
      <div class="founder-copy">
        <span class="kicker">Conoce a Marilyn</span>
        <h2>Hola, soy Marilyn.</h2>
        <p>
          He dedicado mi vida a este salón y a atender a cada clienta con cariño, criterio y experiencia. El salón lleva el nombre de mi hija, Mía, pero todo lo que hacemos aquí nace del mismo compromiso: que salgas sintiéndote bella, segura y bien cuidada.
        </p>
        <p>
          Nos enfocamos en hacerlo bien — desde un blower impecable hasta color, cambios y servicios para días especiales. Si vienes por primera vez, te vamos a recibir con mucha atención. Si ya nos conoces, sabes cómo trabajamos aquí.
        </p>
        <span class="founder-sig">— Marilyn, fundadora</span>
      </div>
    </div>
  </section>

  <section class="why" id="por-que">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Por qué Mía</span>
        <h2>Lo que no encuentras en otro salón.</h2>
        <p class="section-sub">Técnica dominicana, atención de verdad y resultados que se notan. Eso es lo que nos distingue.</p>
      </div>
      <div class="why-grid">
        {whyMia.map((w, i) => (
          <article class="why-card" style={`--i: ${i}`}>
            <div class="why-num">0{i + 1}</div>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="services" id="servicios">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Servicios</span>
        <h2>Lo que hacemos mejor.</h2>
        <p class="section-sub">Somos especialistas en cabello dominicano — blower, color, novias y transformaciones. Y también atendemos todo lo demás que tu belleza necesita.</p>
      </div>

      <div class="signature-grid">
        {signatureServices.map((s, i) => (
          <article class="signature-card" style={`--i: ${i}`}>
            <span class="service-mark">{s.icon}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <span class="service-price">{s.price}</span>
          </article>
        ))}
      </div>

      <div class="secondary-block">
        <h3 class="secondary-head">Y también te atendemos en…</h3>
        <ul class="secondary-list">
          {secondaryServices.map((s) => (
            <li class="secondary-item">
              <div class="secondary-row">
                <span class="secondary-title">{s.title}</span>
                <span class="secondary-price">{s.price}</span>
              </div>
              <p class="secondary-body">{s.body}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="services-cta" id="consulta">
        <div class="services-cta-card walk-in">
          <h4>¿Visita de siempre?</h4>
          <p>Te atendemos sin cita, por orden de llegada. Llámanos si quieres confirmar la espera.</p>
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Llamar al {phone}</a>
        </div>
        <div class="services-cta-card premium">
          <h4>¿Boda, color completo o transformación?</h4>
          <p>Llámanos antes de la cita para conversar lo que quieres. Así llegamos al día listas — sin sorpresas.</p>
          <a class="btn btn-gold" href={`tel:${phoneTel}`}>Llamar para consulta</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about" id="sobre">
    <div class="container about-grid">
      <div class="about-photo">
        <img src={ownerImg('about-salon.jpg')} alt="Color y blower dominicano en Mía Beauty Boutique" loading="lazy" />
      </div>
      <div class="about-copy">
        <span class="kicker">Sobre nosotras</span>
        <h2>Belleza bien hecha, atención de verdad.</h2>
        <p>
          Mía Beauty Boutique es un salón dominicano en el corazón de Lawrence. Nos conocen por el blower, por el color, por cómo tratamos el cabello y por la forma en que atendemos a cada clienta con dedicación.
        </p>
        <p>
          Aquí se trabaja con técnica, productos profesionales y un ojo claro para lo que te favorece. Queremos que te sientas cómoda, bien orientada y feliz con el resultado.
        </p>
        <div class="stylists">
          {stylists.map((s) => (
            <div class="stylist">
              <h4>{s.name}</h4>
              <span class="stylist-role">{s.role}</span>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <p class="about-pull">
          Cuando sales de aquí, sales viéndote hermosa, sintiéndote segura y sabiendo que valió la pena venir.
        </p>
      </div>
    </div>
  </section>

  <section class="heritage">
    <div class="container heritage-inner">
      <span class="kicker light">Nuestras raíces</span>
      <h2>Cabello dominicano. Técnica que se nota.</h2>
      <p>
        Somos especialistas en cabello dominicano: blower, color, texturas, alisados y cambios bien trabajados. Lo hacemos con práctica, cuidado y una forma de trabajar que se siente en el resultado.
      </p>
    </div>
  </section>

  <section class="work" id="galeria">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Galería</span>
        <h2>Nuestro trabajo.</h2>
        <p class="section-sub">Filtra por categoría · Toca cualquier foto para verla en grande.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filtrar galería">
        {galleryFilters.map((f, i) => (
          <button
            class={`filter-btn${i === 0 ? ' is-active' : ''}`}
            data-filter={f.id}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
      <div class="work-grid" id="gallery-grid">
        {galleryItems.map((w, i) => {
          const path = w.legacy ? img(w.src) : ownerImg(w.src);
          return (
            <figure
              class="work-card"
              data-cat={w.cat}
              style={`--i: ${i}`}
              data-src={path}
              data-label={w.label}
              tabindex="0"
              role="button"
              aria-label={`Ver ${w.label} en grande`}
            >
              <img src={path} alt={w.label} loading="lazy" />
              <figcaption>{w.label}</figcaption>
            </figure>
          );
        })}
      </div>
      <p class="gallery-note">Síguenos en <a href={instagramUrl} target="_blank" rel="noopener">Instagram</a> para fotos nuevas cada semana.</p>
    </div>
  </section>

  <section class="reviews" id="resenas">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Reseñas</span>
        <h2>Lo que dicen nuestras clientas.</h2>
        <p class="section-sub">Reseñas reales de Google, Yelp y Facebook — filtra por lo que vienes a buscar.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filtrar reseñas">
        {reviewFilters.map((f, i) => (
          <button
            class={`filter-btn${i === 0 ? ' is-active' : ''}`}
            data-filter={f.id}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
      <div class="review-grid" id="review-grid">
        {reviews.map((r, i) => (
          <article class="review-card" data-cat={r.cat} style={`--i: ${i}`}>
            <div class="stars" aria-label="5 estrellas">★★★★★</div>
            <blockquote>{r.body}</blockquote>
            <cite>— {r.name} <span class="review-source">· {r.source}</span></cite>
          </article>
        ))}
      </div>
      <div class="reviews-cta">
        <a class="btn btn-primary" href={reviewsUrl} target="_blank" rel="noopener">Leer más reseñas</a>
        <a class="btn btn-ghost" href={reviewsUrl} target="_blank" rel="noopener">Ver reseñas en Google</a>
      </div>
    </div>
  </section>

  <section class="social" id="social">
    <div class="container social-inner">
      <div class="social-copy">
        <span class="kicker">Síguenos</span>
        <h2>Cada semana, transformaciones nuevas.</h2>
        <p>Color, blowouts, novias, antes-y-después — todo en nuestro Instagram. Síguenos para ver el trabajo más reciente del salón.</p>
        <div class="social-cta">
          <a class="btn btn-primary" href={instagramUrl} target="_blank" rel="noopener">Seguir en Instagram</a>
          <a class="btn btn-ghost" href={facebookUrl} target="_blank" rel="noopener">Facebook</a>
        </div>
        <span class="ig-handle">@miabeautyboutique264</span>
      </div>
      <div class="social-grid">
        {galleryItems.slice(0, 6).map((w, i) => {
          const path = w.legacy ? img(w.src) : ownerImg(w.src);
          return (
          <a class="social-tile" href={instagramUrl} target="_blank" rel="noopener" aria-label="Ver en Instagram" style={`--i: ${i}`}>
            <img src={path} alt={w.label} loading="lazy" />
            <span class="social-overlay" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </span>
          </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Preguntas</span>
        <h2>Todo lo que quieres saber antes de venir.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" style={`--i: ${i}`}>
            <summary>
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="worth-drive">
    <div class="container worth-inner">
      <span class="kicker">Vienen de toda el área</span>
      <h3>Clientas de Lawrence, Methuen, Andover, Haverhill, Lowell y Salem, NH.</h3>
      <p>Vale el camino. Vale la técnica. Y siempre vale el cuidado.</p>
    </div>
  </section>

  <section class="visit" id="visitar">
    <div class="container visit-inner">
      <span class="kicker light">Visítanos</span>
      <h2>Te esperamos en Lawrence.</h2>
