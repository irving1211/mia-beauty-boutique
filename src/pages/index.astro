---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const phone = '(978) 208-7877';
const phoneTel = '+19782087877';
const address = '264 S Broadway, Lawrence, MA 01843';
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=264+S+Broadway%2C+Lawrence%2C+MA+01843';
const mapsUrl = 'https://www.google.com/maps/place/264+S+Broadway,+Lawrence,+MA+01843';
const reviewsUrl = 'https://www.google.com/search?q=Mia+Beauty+Boutique+Lawrence+MA';
const writeReviewUrl = 'https://search.google.com/local/writereview?placeid=ChIJ_____MiaBeautyBoutique'; // placeholder until real Place ID confirmed
const instagramUrl = 'https://www.instagram.com/miabeautyboutique264/';
const facebookUrl = 'https://www.facebook.com/p/Mia-Beauty-Boutique-100058155380527/';
const yelpUrl = 'https://www.yelp.com/biz/mia-beauty-boutique-lawrence-2';

const BASE = import.meta.env.BASE_URL;
const img = (name: string) => `${BASE}images/work/${name}`;

const services = [
  { title: 'Dominican Blowout', icon: '✦', body: 'Nuestra especialidad. Cabello suave, brillante y con cuerpo — el blowout dominicano que nos hizo famosas.', price: 'Desde $45' },
  { title: 'Color y Mechas', icon: '✦', body: 'Color, balayage, plum, ombré. Pravana y las mejores marcas. Cabello sano siempre primero.', price: 'Llama para consulta' },
  { title: 'Cortes', icon: '✦', body: 'Cortes clásicos, modernos, capas, flequillo. Cortes que te hacen ver y sentir bien.', price: 'Desde $30' },
  { title: 'Extensiones', icon: '✦', body: 'Extensiones brasileras y de cabello natural. Volumen, largo, transformación completa.', price: 'Consulta requerida' },
  { title: 'Maquillaje Profesional', icon: '✦', body: 'Para eventos, sesiones de fotos, o solo para verte extra bella. Marcas de lujo.', price: 'Desde $65' },
  { title: 'Novias', icon: '✦', body: 'Maquillaje y peinado de novia. Servicio especial — separa tu fecha con tiempo.', price: 'Cita previa requerida' },
  { title: 'Depilación con Hilo', icon: '✦', body: 'Cejas, bigote, rostro. Técnica precisa y delicada para piel sensible.', price: 'Desde $12' },
  { title: 'Tratamientos', icon: '✦', body: 'Hidratación profunda, queratina, brillo y reparación para todo tipo de cabello.', price: 'Desde $40' },
];

const whyMia = [
  { title: 'Experiencia dominicana auténtica', body: 'Más de 40 años especializadas en cabello dominicano. Conocemos texturas, rizos, ondas — y cómo sacarles lo mejor.' },
  { title: 'Sin cita, sin estrés', body: 'Walk-ins bienvenidas. Llega cuando puedas y te atendemos por orden. Perfecto para mamás ocupadas y horarios apretados.' },
  { title: 'Bilingüe y familiar', body: 'Te atendemos en español o english. Salón familiar — tres generaciones de clientas, cero ambiente de fábrica.' },
  { title: 'Resultados que duran', body: 'Blowouts que aguantan toda la semana. Color que cuida el cabello. Técnica con décadas de oficio detrás.' },
];

const stylists = [
  { name: 'Mía', role: 'Fundadora · Maestra estilista', body: 'Más de 40 años perfeccionando el blowout dominicano. Tres generaciones de clientas la conocen por nombre.' },
  { name: 'El equipo', role: 'Estilistas bilingües', body: 'Especialistas en color, cortes, extensiones, novias y maquillaje. Trabajamos en equipo — siempre tienes a alguien lista para atenderte.' },
];

const reviews = [
  { name: 'Yesenia M.', source: 'Google', body: 'Todas las muchachas son tan dulces. Y trabajan en equipo — siempre salgo feliz. Mi blowout dura toda la semana.' },
  { name: 'Carmen R.', source: 'Google', body: 'Me hicieron sentir como una reina el día de mi boda. El maquillaje duró todo el día y todas las fotos quedaron preciosas.' },
  { name: 'Mariela P.', source: 'Yelp', body: 'Llevo años yendo. Mía y su equipo conocen mi cabello como nadie. No voy a otro salón.' },
  { name: 'Joselyn T.', source: 'Google', body: 'Sin cita previa y siempre me atienden rápido. Mi blowout dura toda la semana. Las recomiendo a todas mis amigas.' },
  { name: 'Andrea S.', source: 'Facebook', body: 'El mejor color que me han hecho en mi vida. Saben cuidar el cabello — no se quema, no se daña. Pravana de verdad.' },
  { name: 'Linette V.', source: 'Google', body: 'Me hicieron las extensiones para mi quinceañera. Quedaron naturales, suaves, y mi mamá lloró de la emoción. Gracias Mía.' },
];

const galleryItems = [
  { src: 'mia-1.jpg', cat: 'blower', label: 'Dominican Blowout' },
  { src: 'mia-2.jpg', cat: 'color', label: 'Color y Mechas' },
  { src: 'mia-3.jpg', cat: 'novias', label: 'Novias' },
  { src: 'mia-4.jpg', cat: 'blower', label: 'Dominican Blowout' },
  { src: 'mia-5.jpg', cat: 'color', label: 'Color' },
  { src: 'mia-6.jpg', cat: 'extensiones', label: 'Extensiones' },
  { src: 'mia-7.jpg', cat: 'cortes', label: 'Cortes' },
  { src: 'mia-8.jpg', cat: 'blower', label: 'Dominican Blowout' },
];

const galleryFilters = [
  { id: 'todo', label: 'Todo' },
  { id: 'blower', label: 'Blower' },
  { id: 'color', label: 'Color' },
  { id: 'novias', label: 'Novias' },
  { id: 'extensiones', label: 'Extensiones' },
  { id: 'cortes', label: 'Cortes' },
];

const faqs = [
  { q: '¿Tengo que hacer cita?', a: 'No, te atendemos sin cita por orden de llegada. Para servicios largos (novias, color completo, extensiones) recomendamos llamar antes para asegurar tu hora.' },
  { q: '¿Cuáles son los mejores días para venir?', a: 'Martes a jueves son nuestros días más tranquilos. Viernes y sábados son los más llenos — te atendemos igual, pero la espera puede ser más larga. Si vienes temprano, mejor.' },
  { q: '¿Trabajan con todo tipo de cabello?', a: 'Sí. Somos especialistas en cabello dominicano — rizos, ondas, texturas mixtas, cabello fino, grueso, teñido, todo. Décadas de experiencia con cada tipo.' },
  { q: '¿Cuánto dura el blowout dominicano?', a: 'Con cuidado básico (gorro de noche, no mojarlo) un blowout dominicano nuestro te dura toda la semana — muchas clientas llegan a 10 días.' },
  { q: '¿Hacen novias y eventos grandes?', a: 'Sí. Para novias separa tu fecha con tiempo (idealmente 4-8 semanas antes). Ofrecemos prueba de maquillaje y peinado. Llama para hablar de tu día.' },
  { q: '¿Qué formas de pago aceptan?', a: 'Efectivo y tarjeta de crédito (Visa, Mastercard, Amex). Si tienes alguna duda, llámanos antes de venir.' },
  { q: '¿Hay parqueo?', a: 'Sí, parqueo gratis en la calle y en lotes cercanos en S Broadway. Plaza fácil de encontrar — estamos en el corazón de Lawrence.' },
  { q: '¿Hablan inglés?', a: 'Sí. Todo el equipo es bilingüe — español e inglés. Atendemos a clientas de Lawrence, Methuen, Andover, Haverhill, Lowell, y Salem NH.' },
];
---

<Base lang="es" pathEs="/" pathEn="/en/">
  <header class="topbar">
    <div class="container topbar-row">
      <a class="brand" href="#top" aria-label="Mía Beauty Boutique">
        <Logo size="md" />
      </a>
      <nav class="nav" aria-label="Principal">
        <a href="#por-que" data-nav>Por Qué Mía</a>
        <a href="#servicios" data-nav>Servicios</a>
        <a href="#galeria" data-nav>Galería</a>
        <a href="#resenas" data-nav>Reseñas</a>
        <a href="#faq" data-nav>FAQ</a>
        <a href="#visitar" data-nav>Visitar</a>
      </nav>
      <div class="topbar-right">
        <a class="lang-switch" href={`${BASE}en/`} hreflang="en" aria-label="View in English">EN</a>
        <a class="topbar-call" href={`tel:${phoneTel}`}>{phone}</a>
      </div>
    </div>
  </header>

  <section class="hero" id="top">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Lawrence, MA · Más de 40 años haciéndote sentir bella</span>
        <h1>Donde el cabello dominicano <em>brilla</em>.</h1>
        <p class="hero-lede">
          Mía Beauty Boutique es un salón familiar en Lawrence, MA — más de cuatro décadas perfeccionando el blowout dominicano, el color, las novias, y todo lo que te hace verte como tú quieres verte.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Llamar al salón</a>
          <a class="btn btn-gold" href={directionsUrl} target="_blank" rel="noopener">Cómo llegar</a>
          <a class="btn btn-ghost" href="#galeria">Ver galería</a>
        </div>
        <ul class="hero-stats">
          <li><strong>40+</strong><span>años de experiencia</span></li>
          <li><strong>Sin cita</strong><span>te atendemos por orden</span></li>
          <li><strong>Bilingüe</strong><span>español · english</span></li>
          <li><strong>Familia</strong><span>3 generaciones</span></li>
        </ul>
      </div>
      <div class="hero-photo">
        <img src={img('mia-1.jpg')} alt="Trabajo destacado de Mía Beauty Boutique" loading="eager" />
        <div class="hero-badge">
          <strong>40+</strong>
          <span>años en Lawrence</span>
        </div>
      </div>
    </div>
  </section>

  <section class="why" id="por-que">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Por qué Mía</span>
        <h2>Lo que no encuentras en otro salón.</h2>
        <p class="section-sub">Décadas de oficio dominicano, ambiente familiar, y resultados que duran. Esto es lo que nos hace diferentes.</p>
      </div>
      <div class="why-grid">
        {whyMia.map((w, i) => (
          <article class="why-card" style={`--i: ${i}`}>
            <div class="why-num">0{i + 1}</div>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="services" id="servicios">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Servicios</span>
        <h2>Todo lo que tu belleza necesita.</h2>
        <p class="section-sub">Especialistas en cabello dominicano. También te atendemos en maquillaje, novias, y depilación. Precios desde — llama para confirmar.</p>
      </div>
      <div class="service-grid">
        {services.map((s, i) => (
          <article class="service-card" style={`--i: ${i}`}>
            <span class="service-mark">{s.icon}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <span class="service-price">{s.price}</span>
          </article>
        ))}
      </div>
      <div class="services-cta">
        <p>¿No ves tu servicio? Llámanos — probablemente lo hacemos.</p>
        <div class="services-cta-row">
          <a class="btn btn-primary" href={`tel:${phoneTel}`}>Llamar al {phone}</a>
          <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener">Cómo llegar</a>
        </div>
      </div>
    </div>
  </section>

  <section class="about" id="sobre">
    <div class="container about-grid">
      <div class="about-photo">
        <img src={img('mia-2.jpg')} alt="Equipo de Mía Beauty Boutique" loading="lazy" />
      </div>
      <div class="about-copy">
        <span class="kicker">Sobre Nosotras</span>
        <h2>Cuatro décadas haciéndote sentir como en casa.</h2>
        <p>
          Mía Beauty Boutique es un salón dominicano familiar en el corazón de Lawrence. Llevamos más de 40 años atendiendo a tres generaciones de clientas — abuelas, mamás, hijas, y ahora nietas.
        </p>
        <p>
          Lo que hace a Mía especial no es solo la técnica — aunque la técnica está ahí. Es el ambiente: las muchachas que trabajan en equipo, el café mientras esperas, las conversaciones en español, y la atención que te hace sentir como familia.
        </p>
        <div class="stylists">
          {stylists.map((s) => (
            <div class="stylist">
              <h4>{s.name}</h4>
              <span class="stylist-role">{s.role}</span>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <p class="about-pull">
          La promesa: cuando sales de aquí, te sientes más bella, más cuidada, y más tú.
        </p>
      </div>
    </div>
  </section>

  <section class="work" id="galeria">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Galería</span>
        <h2>Nuestro trabajo.</h2>
        <p class="section-sub">Filtra por categoría · Toca cualquier foto para verla en grande.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filtrar galería">
        {galleryFilters.map((f, i) => (
          <button
            class={`filter-btn${i === 0 ? ' is-active' : ''}`}
            data-filter={f.id}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >{f.label}</button>
        ))}
      </div>
      <div class="work-grid" id="gallery-grid">
        {galleryItems.map((w, i) => (
          <figure
            class="work-card"
            data-cat={w.cat}
            style={`--i: ${i}`}
            data-src={img(w.src)}
            data-label={w.label}
            tabindex="0"
            role="button"
            aria-label={`Ver ${w.label} en grande`}
          >
            <img src={img(w.src)} alt={w.label} loading="lazy" />
            <figcaption>{w.label}</figcaption>
          </figure>
        ))}
      </div>
      <p class="gallery-note">Síguenos en <a href={instagramUrl} target="_blank" rel="noopener">Instagram</a> para fotos nuevas cada semana.</p>
    </div>
  </section>

  <section class="reviews" id="resenas">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Reseñas</span>
        <h2>Lo que dicen nuestras clientas.</h2>
        <p class="section-sub">Reseñas reales de Google, Yelp y Facebook.</p>
      </div>
      <div class="review-grid">
        {reviews.map((r, i) => (
          <article class="review-card" style={`--i: ${i}`}>
            <div class="stars" aria-label="5 estrellas">★★★★★</div>
            <blockquote>{r.body}</blockquote>
            <cite>— {r.name} <span class="review-source">· {r.source}</span></cite>
          </article>
        ))}
      </div>
      <div class="reviews-cta">
        <a class="btn btn-primary" href={reviewsUrl} target="_blank" rel="noopener">Leer más reseñas</a>
        <a class="btn btn-ghost" href={writeReviewUrl} target="_blank" rel="noopener">Dejar una reseña</a>
      </div>
    </div>
  </section>

  <section class="social" id="social">
    <div class="container social-inner">
      <div class="social-copy">
        <span class="kicker">Síguenos</span>
        <h2>Cada semana, transformaciones nuevas.</h2>
        <p>Color, blowouts, novias, antes-y-después — todo en nuestro Instagram. Síguenos para ver el trabajo más reciente del salón.</p>
        <div class="social-cta">
          <a class="btn btn-primary" href={instagramUrl} target="_blank" rel="noopener">Seguir en Instagram</a>
          <a class="btn btn-ghost" href={facebookUrl} target="_blank" rel="noopener">Facebook</a>
        </div>
        <span class="ig-handle">@miabeautyboutique264</span>
      </div>
      <div class="social-grid">
        {galleryItems.slice(0, 6).map((w, i) => (
          <a class="social-tile" href={instagramUrl} target="_blank" rel="noopener" aria-label="Ver en Instagram" style={`--i: ${i}`}>
            <img src={img(w.src)} alt={w.label} loading="lazy" />
            <span class="social-overlay" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="faq" id="faq">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Preguntas</span>
        <h2>Todo lo que quieres saber antes de venir.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details class="faq-item" style={`--i: ${i}`}>
            <summary>
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="visit" id="visitar">
    <div class="container visit-inner">
      <span class="kicker light">Visítanos</span>
      <h2>Te esperamos en Lawrence.</h2>
      <div class="visit-grid">
        <div class="visit-info">
          <ul class="visit-list">
            <li><span class="lbl">Dirección</span><span>{address}</span></li>
            <li><span class="lbl">Teléfono</span><a href={`tel:${phoneTel}`}>{phone}</a></li>
            <li><span class="lbl">Sin cita previa</span><span>Te atendemos por orden de llegada</span></li>
            <li><span class="lbl">Parqueo</span><span>Gratis en la calle y lotes cercanos</span></li>
            <li><span class="lbl">Pago</span><span>Efectivo y tarjeta (Visa · MC · Amex)</span></li>
            <li><span class="lbl">Mejor día</span><span>Martes a jueves — menos espera</span></li>
            <li><span class="lbl">Novias y color completo</span><span>Llama antes para separar tu hora</span></li>
          </ul>
          <div class="visit-ctas">
            <a class="btn btn-primary big" href={`tel:${phoneTel}`}>Llamar ahora</a>
            <a class="btn btn-gold big" href={directionsUrl} target="_blank" rel="noopener">Cómo llegar</a>
          </div>
        </div>
        <div class="visit-hours">
          <h3>Horario</h3>
          <ul class="hours-list">
            <li><span>Martes</span><span>9:30am – 6:00pm</span></li>
            <li><span>Miércoles</span><span>9:30am – 6:00pm</span></li>
            <li><span>Jueves</span><span>9:30am – 6:00pm</span></li>
            <li><span>Viernes</span><span>8:00am – 5:30pm</span></li>
            <li><span>Sábado</span><span>7:00am – 5:00pm</span></li>
            <li class="closed"><span>Domingo</span><span>Cerrado</span></li>
            <li class="closed"><span>Lunes</span><span>Cerrado</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <Logo size="sm" variant="light" />
      </div>
      <div class="footer-meta">
        <a href={`tel:${phoneTel}`}>{phone}</a>
        <span class="dot">·</span>
        <span>{address}</span>
        <br />
        <a href={instagramUrl} rel="noopener" target="_blank">Instagram</a>
        <span class="dot">·</span>
        <a href={facebookUrl} rel="noopener" target="_blank">Facebook</a>
        <span class="dot">·</span>
        <a href={yelpUrl} rel="noopener" target="_blank">Yelp</a>
        <span class="dot">·</span>
        <a href={`${BASE}en/`} hreflang="en">English</a>
      </div>
      <div class="footer-fineprint">© {new Date().getFullYear()} Mía Beauty Boutique · Lawrence, MA</div>
    </div>
  </footer>

  <div class="mobile-bar">
    <a class="mobile-bar-btn primary" href={`tel:${phoneTel}`} aria-label="Llamar al salón">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>Llamar</span>
    </a>
    <a class="mobile-bar-btn gold" href={directionsUrl} target="_blank" rel="noopener" aria-label="Cómo llegar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Cómo llegar</span>
    </a>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button class="lightbox-close" type="button" aria-label="Cerrar">×</button>
    <button class="lightbox-prev" type="button" aria-label="Anterior">‹</button>
    <button class="lightbox-next" type="button" aria-label="Siguiente">›</button>
    <figure class="lightbox-figure">
      <img id="lightbox-img" alt="" />
      <figcaption id="lightbox-cap"></figcaption>
    </figure>
  </div>

  <style>
    .topbar { background: rgba(251,246,239,.78); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid transparent; position: sticky; top: 0; z-index: 50; transition: background .25s ease, border-color .25s ease, box-shadow .25s ease; }
    .topbar.scrolled { background: rgba(251,246,239,.95); border-bottom-color: var(--line); box-shadow: 0 1px 0 rgba(122,31,43,.02), 0 6px 20px rgba(122,31,43,.04); }
    .topbar-row { display: flex; align-items: center; gap: 1.5rem; padding: .65rem 1.75rem; transition: padding .25s ease; }
    .topbar.scrolled .topbar-row { padding: .45rem 1.75rem; }
    .brand { display: flex; align-items: center; }
    .brand :global(svg) { height: 72px; width: auto; }
    .nav { display: flex; gap: 1.4rem; margin-left: auto; }
    .nav a { color: var(--ink-soft); font-weight: 500; font-size: .94rem; position: relative; padding: .3rem 0; }
    .nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--burgundy); transform: scaleX(0); transform-origin: left; transition: transform .25s ease; border-radius: 2px; }
    .nav a:hover { color: var(--burgundy); opacity: 1; }
    .nav a.is-active { color: var(--burgundy); }
    .nav a.is-active::after { transform: scaleX(1); }
    .topbar-right { display: flex; align-items: center; gap: .65rem; }
