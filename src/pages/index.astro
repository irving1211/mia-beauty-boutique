    .site-footer { background: #2a1a1d; color: rgba(251,246,239,.65); padding: 3rem 0 2.5rem; font-size: .9rem; }
    .footer-inner { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem 2rem; align-items: center; }
    .footer-brand { display: flex; align-items: center; }
    .footer-brand :global(svg) { height: 50px; width: auto; }
    .footer-meta { text-align: right; }
    .footer-meta a { color: var(--gold-light); }
    .footer-meta a:hover { color: var(--cream); opacity: 1; }
    .footer-meta .dot { color: rgba(251,246,239,.25); padding: 0 .35rem; }
    .footer-fineprint { grid-column: 1 / -1; text-align: center; padding-top: 1.5rem; border-top: 1px solid rgba(251,246,239,.08); font-size: .82rem; color: rgba(251,246,239,.4); }

    .mobile-bar { display: none; position: fixed; bottom: 0; left: 0; right: 0; padding: .65rem .75rem calc(.65rem + env(safe-area-inset-bottom, 0)); background: rgba(251,246,239,.98); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-top: 1px solid var(--line); gap: .55rem; z-index: 100; box-shadow: 0 -8px 30px rgba(122,31,43,.1); }
    .mobile-bar-btn { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .9rem 1rem; border-radius: 999px; font-weight: 600; font-size: .94rem; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
    .mobile-bar-btn.primary { background: var(--burgundy); color: var(--cream); }
    .mobile-bar-btn.primary:active { transform: scale(.97); }
    .mobile-bar-btn.gold { background: var(--gold); color: #fff; }
    .mobile-bar-btn.gold:active { transform: scale(.97); }
    .mobile-bar-btn svg { flex-shrink: 0; }

    .lightbox { position: fixed; inset: 0; background: rgba(20,8,12,.92); display: none; align-items: center; justify-content: center; z-index: 200; padding: 2rem; opacity: 0; transition: opacity .2s ease; }
    .lightbox.is-open { display: flex; opacity: 1; }
    .lightbox-figure { margin: 0; max-width: 90vw; max-height: 90vh; display: flex; flex-direction: column; align-items: center; gap: .8rem; }
    .lightbox img { max-width: 90vw; max-height: 78vh; border-radius: 12px; object-fit: contain; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
    .lightbox figcaption { color: var(--cream); font-family: 'Cormorant Garamond', serif; font-size: 1.15rem; font-style: italic; letter-spacing: .02em; }
    .lightbox-close, .lightbox-prev, .lightbox-next { position: absolute; background: rgba(251,246,239,.12); border: 1px solid rgba(251,246,239,.25); color: var(--cream); width: 48px; height: 48px; border-radius: 50%; font-size: 1.6rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .15s ease, transform .15s ease; font-family: inherit; line-height: 1; }
    .lightbox-close { top: 1.25rem; right: 1.25rem; }
    .lightbox-prev { left: 1.5rem; top: 50%; transform: translateY(-50%); }
    .lightbox-next { right: 1.5rem; top: 50%; transform: translateY(-50%); }
    .lightbox-close:hover, .lightbox-prev:hover, .lightbox-next:hover { background: rgba(251,246,239,.22); }
    .lightbox-prev:hover { transform: translateY(-50%) scale(1.08); }
    .lightbox-next:hover { transform: translateY(-50%) scale(1.08); }

    .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s cubic-bezier(0.22,0.61,0.36,1), transform .7s cubic-bezier(0.22,0.61,0.36,1); transition-delay: calc(var(--i, 0) * 60ms); }
    .reveal.is-visible { opacity: 1; transform: translateY(0); }
    @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

    @media (max-width: 980px) {
      .social-inner { grid-template-columns: 1fr; gap: 2rem; }
    }

    @media (max-width: 900px) {
      .nav { display: none; }
      .topbar-row { padding: .55rem 1rem; gap: .6rem; }
      .topbar-call { padding: .5rem .85rem; font-size: .85rem; }
      .lang-switch { padding: .35rem .6rem; font-size: .72rem; }
      .brand :global(svg) { height: 56px; }
      .hero { padding: 3rem 0 4.5rem; }
      .hero-grid, .about-grid, .visit-grid, .founder-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .hero-photo { order: -1; max-width: 340px; margin: 0 auto; }
      .hero-photo img { aspect-ratio: 1/1; }
      .hero-badge { bottom: -14px; left: -10px; padding: .7rem 1rem; }
      .hero-badge strong { font-size: 1.4rem; }
      .hero h1 { font-size: clamp(2rem, 8vw, 2.8rem); }
      .hero-cta { flex-direction: column; gap: .7rem; }
      .hero-cta .btn { justify-content: center; width: 100%; }
      .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; padding: 1.5rem 0 0; }
      .hero-stats strong { font-size: 1.5rem; }
      .founder { padding: 3.5rem 0; }
      .founder-photo { max-width: 320px; margin: 0 auto; }
      .why, .services, .about, .work, .reviews, .social, .faq, .visit { padding: 4rem 0; }
      .heritage { padding: 3.5rem 0; }
      .heritage p { font-size: 1rem; }
      .section-head { margin-bottom: 2.5rem; }
      .about-photo { max-width: 360px; margin: 0 auto; }
      .stylists { grid-template-columns: 1fr; }
      .signature-grid { grid-template-columns: 1fr; gap: 1rem; }
      .signature-card { padding: 1.8rem 1.5rem; }
      .signature-card h3 { font-size: 1.35rem; }
      .secondary-list { grid-template-columns: 1fr; }
      .secondary-item:nth-last-child(2) { border-bottom: 1px solid var(--line); }
      .secondary-block { padding: 1.5rem 1.4rem; }
      .services-cta { grid-template-columns: 1fr; }
      .visit-ctas { flex-direction: column; }
      .visit-ctas .btn { width: 100%; justify-content: center; }
      .footer-inner { grid-template-columns: 1fr; text-align: center; }
      .footer-brand { justify-content: center; }
      .footer-meta { text-align: center; }
      .mobile-bar { display: flex; }
      body { padding-bottom: 5.5rem; }
      .lightbox-prev, .lightbox-next { width: 40px; height: 40px; font-size: 1.4rem; }
      .lightbox-prev { left: .5rem; }
      .lightbox-next { right: .5rem; }
    }

    @media (max-width: 480px) {
      .hero-stats { grid-template-columns: 1fr 1fr; }
    }
  </style>

  <script is:inline>
    // Topbar scroll state
    (() => {
      const topbar = document.querySelector('.topbar');
      if (!topbar) return;
      const onScroll = () => topbar.classList.toggle('scrolled', window.scrollY > 30);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();

    // Reveal-on-scroll with stagger via --i
    (() => {
      if (!('IntersectionObserver' in window)) return;
      const targets = document.querySelectorAll('section, .work-card, .signature-card, .review-card, .why-card, .faq-item, .social-tile');
      targets.forEach((el) => el.classList.add('reveal'));
      const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
      targets.forEach((el) => io.observe(el));
    })();

    // Active-nav-on-scroll
    (() => {
      if (!('IntersectionObserver' in window)) return;
      const links = document.querySelectorAll('[data-nav]');
      if (!links.length) return;
      const map = new Map();
      links.forEach((a) => {
        const href = a.getAttribute('href') || '';
        if (href.startsWith('#')) {
          const id = href.slice(1);
          const sec = document.getElementById(id);
          if (sec) map.set(sec, a);
        }
      });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          const a = map.get(e.target);
          if (!a) return;
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('is-active'));
            a.classList.add('is-active');
          }
        });
      }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });
      map.forEach((_a, sec) => io.observe(sec));
    })();

    // Gallery filter (scoped to .work section)
    (() => {
      const btns = document.querySelectorAll('.work .filter-btn');
      const items = document.querySelectorAll('#gallery-grid .work-card');
      if (!btns.length || !items.length) return;
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          btns.forEach((b) => { b.classList.remove('is-active'); b.setAttribute('aria-selected', 'false'); });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');
          items.forEach((it) => {
            const cat = it.getAttribute('data-cat');
            if (filter === 'todo' || cat === filter) it.classList.remove('is-hidden');
            else it.classList.add('is-hidden');
          });
        });
      });
    })();

    // Reviews filter (scoped to .reviews section)
    (() => {
      const btns = document.querySelectorAll('.reviews .filter-btn');
      const items = document.querySelectorAll('#review-grid .review-card');
      if (!btns.length || !items.length) return;
      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          btns.forEach((b) => { b.classList.remove('is-active'); b.setAttribute('aria-selected', 'false'); });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');
          items.forEach((it) => {
            const cat = it.getAttribute('data-cat');
            if (filter === 'todo' || cat === filter) it.classList.remove('is-hidden');
            else it.classList.add('is-hidden');
          });
        });
      });
    })();

    // Lightbox
    (() => {
      const lb = document.getElementById('lightbox');
      const lbImg = document.getElementById('lightbox-img');
      const lbCap = document.getElementById('lightbox-cap');
      const closeBtn = lb && lb.querySelector('.lightbox-close');
      const prevBtn = lb && lb.querySelector('.lightbox-prev');
      const nextBtn = lb && lb.querySelector('.lightbox-next');
      const cards = Array.from(document.querySelectorAll('#gallery-grid .work-card'));
      if (!lb || !lbImg || !lbCap || !cards.length) return;
      let idx = 0;

      function visibleCards() { return cards.filter((c) => !c.classList.contains('is-hidden')); }
      function open(i) {
        const list = visibleCards();
        if (!list.length) return;
        idx = ((i % list.length) + list.length) % list.length;
        const card = list[idx];
        lbImg.src = card.getAttribute('data-src') || '';
        lbImg.alt = card.getAttribute('data-label') || '';
        lbCap.textContent = card.getAttribute('data-label') || '';
        lb.classList.add('is-open');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function close() {
        lb.classList.remove('is-open');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      function step(d) { open(idx + d); }

      cards.forEach((card) => {
        card.addEventListener('click', () => {
          const list = visibleCards();
          const pos = list.indexOf(card);
          open(pos >= 0 ? pos : 0);
        });
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
        });
      });
      closeBtn && closeBtn.addEventListener('click', close);
      prevBtn && prevBtn.addEventListener('click', () => step(-1));
      nextBtn && nextBtn.addEventListener('click', () => step(1));
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
      document.addEventListener('keydown', (e) => {
        if (!lb.classList.contains('is-open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
      });
    })();
  </script>
